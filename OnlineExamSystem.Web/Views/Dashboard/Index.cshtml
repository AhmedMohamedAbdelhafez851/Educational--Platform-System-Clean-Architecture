@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model OnlineExamSystem.Application.DTOs.Dashboard.GeneralDashboardDto

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
@*     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
 *@    <link href="~/css/pages/dashboard.css" rel="stylesheet">
}

<div class="dashboard-container"
     data-total-students="@Model.TotalStudents"
     data-total-exams="@Model.TotalExams"
     data-avg-score="@Model.AverageStudentScore"
     data-attendance-rate="@Model.AttendanceRate"
     data-students-attention="@Model.StudentsNeedingAttention"
     data-exams-this-week="@Model.ExamsThisWeek">

    <!-- Header -->
    <div class="dashboard-header">
        <h1>@Localizer["WelcomeMessage"]</h1>
        <p>@Localizer["Subtitle"]</p>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-grid">
        <div class="kpi-card" onclick="showDetails('students', '@Localizer["TotalStudents"]')">
            <div class="kpi-header">
                <span class="kpi-label">@Localizer["TotalStudents"]</span>
                <div class="kpi-icon" style="background: #eff6ff; color: #3b82f6;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="kpi-value">@Model.TotalStudents</div>
            <div class="kpi-insight">@Localizer["ActiveStudents"]</div>
        </div>

        <div class="kpi-card" onclick="showDetails('exams', '@Localizer["TotalExams"]')">
            <div class="kpi-header">
                <span class="kpi-label">@Localizer["TotalExams"]</span>
                <div class="kpi-icon" style="background: #f0fdf4; color: #10b981;">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
            </div>
            <div class="kpi-value">@Model.TotalExams</div>
            <div class="kpi-insight">@Model.ExamsThisWeek @Localizer["CreatedThisWeek"]</div>
        </div>

        <div class="kpi-card" onclick="showDetails('score', '@Localizer["AverageScore"]')">
            <div class="kpi-header">
                <span class="kpi-label">@Localizer["AverageScore"]</span>
                <div class="kpi-icon" style="background: #fef3c7; color: #f59e0b;">
                    <i class="bi bi-trophy"></i>
                </div>
            </div>
            <div class="kpi-value">@Model.AverageStudentScore.ToString("F1")%</div>
            <div class="kpi-insight">@Localizer["OverallPerformance"]</div>
        </div>

        <div class="kpi-card" onclick="showDetails('attention', '@Localizer["NeedsAttention"]')">
            <div class="kpi-header">
                <span class="kpi-label">@Localizer["NeedsAttention"]</span>
                <div class="kpi-icon" style="background: #fef2f2; color: #ef4444;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
            <div class="kpi-value">@Model.StudentsNeedingAttention</div>
            <div class="kpi-insight">@Localizer["StudentsNeedingFollowUp"]</div>
        </div>

        <div class="kpi-card" onclick="showDetails('attendance', '@Localizer["AttendanceRate"]')">
            <div class="kpi-header">
                <span class="kpi-label">@Localizer["AttendanceRate"]</span>
                <div class="kpi-icon" style="background: #e0e7ff; color: #4338ca;">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
            <div class="kpi-value">@Model.AttendanceRate.ToString("F1")%</div>
            <div class="kpi-insight">@Localizer["AverageExamAttendance"]</div>
        </div>
    </div>

    <!-- First Row -->
    <div class="two-columns">
        <!-- Recent Exams -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-clock-history"></i>
                    @Localizer["RecentExams"]
                </h3>
                <a asp-controller="Exam" asp-action="Index" class="btn-sm btn-outline">
                    @Localizer["ViewAll"] <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="scrollable-section">
                <div class="card-body">
                    @if (Model.RecentExams.Any())
                    {
                        @foreach (var exam in Model.RecentExams)
                        {
                            <div class="exam-item" onclick="goToExam(@exam.ExamId)">
                                <div class="exam-info">
                                    <h4>@exam.Title</h4>
                                    <div class="exam-meta">
                                        <span><i class="bi bi-calendar"></i> @exam.Date.ToString("MMM dd, yyyy")</span>
                                        <span><i class="bi bi-people"></i> @exam.AttendancePercentage.ToString("F0")% @Localizer["Attended"]</span>
                                    </div>
                                </div>
                                <div class="exam-score">@exam.AverageScore.ToString("F1")%</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="bi bi-journal-x"></i></div>
                            <h4>@Localizer["NoExamsYet"]</h4>
                            <p>@Localizer["CreateFirstExamMessage"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Students Needing Attention -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-exclamation-triangle-fill" style="color: #ef4444;"></i>
                    @Localizer["StudentsNeedingAttention"]
                </h3>
                <a asp-controller="Users" asp-action="Index" class="btn-sm btn-outline">
                    @Localizer["ViewAll"] <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="scrollable-section">
                <div class="card-body">
                    @if (Model.StudentsNeedingAttentionList.Any())
                    {
                        @foreach (var student in Model.StudentsNeedingAttentionList)
                        {
                            <div class="attention-student" onclick="showStudentDetails('@student.StudentName', @student.LatestScore)">
                                <div class="student-info">
                                    <div class="student-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div class="student-details">
                                        <h4>@student.StudentName</h4>
                                        <div class="student-issue">@student.Issue</div>
                                    </div>
                                </div>
                                <div class="student-score">@student.LatestScore.ToString("F1")%</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="bi bi-check-circle-fill text-success"></i></div>
                            <h4>@Localizer["AllStudentsWell"]</h4>
                            <p>@Localizer["NoStrugglingStudents"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row -->
    <div class="two-columns">
        <!-- Recent Activity -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-activity"></i>
                    @Localizer["RecentActivity"]
                </h3>
            </div>
            <div class="scrollable-section">
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        @foreach (var activity in Model.RecentActivities.Take(8))
                        {
                            <div class="activity-item">
                                <div class="activity-icon" style="background: @(activity.Color == "success" ? "#f0fdf4" : activity.Color == "danger" ? "#fef2f2" : "#eff6ff");">
                                    <i class="bi bi-@activity.Icon" style="color: @(activity.Color == "success" ? "#10b981" : activity.Color == "danger" ? "#ef4444" : "#3b82f6");"></i>
                                </div>
                                <div class="activity-content">
                                    <div class="activity-message">@activity.Message</div>
                                    <div class="activity-time">@activity.Timestamp.ToString("MMM dd, hh:mm tt")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                            <h4>@Localizer["NoRecentActivity"]</h4>
                            <p>@Localizer["ActivityWillAppear"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming Exams -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-calendar-event"></i>
                    @Localizer["UpcomingExams"]
                </h3>
            </div>
            <div class="scrollable-section">
                <div class="card-body">
                    @if (Model.UpcomingExams.Any())
                    {
                        @foreach (var exam in Model.UpcomingExams.Take(5))
                        {
                            <div class="exam-item" onclick="goToExam(@exam.ExamId)">
                                <div class="exam-info">
                                    <h4>@exam.Title</h4>
                                    <div class="exam-meta">
                                        <span><i class="bi bi-calendar"></i> @exam.DateTime.ToString("MMM dd, yyyy")</span>
                                        <span><i class="bi bi-people"></i> @exam.StudentCount @Localizer["Students"]</span>
                                    </div>
                                </div>
                                <span class="badge badge-primary">@exam.Status</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="bi bi-calendar-x"></i></div>
                            <h4>@Localizer["NoUpcomingExams"]</h4>
                            <p>@Localizer["CreateExamToSee"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Smart Insights -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-lightbulb"></i>
                @Localizer["SmartInsights"]
            </h3>
        </div>
        <div class="card-body">
            @if (Model.SmartInsights.Any())
            {
                @foreach (var insight in Model.SmartInsights)
                {
                    <div class="insight-item insight-@insight.Type" onclick="showInsightDetails('@insight.Message', '@insight.Type')">
                        <span>@insight.Message</span>
                        <span class="btn-sm btn-outline">@Localizer["ViewDetails"] →</span>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-lightbulb-off"></i></div>
                    <h4>@Localizer["NoInsights"]</h4>
                    <p>@Localizer["InsightsWillAppear"]</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Detail Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="custom-modal-header">
                <h5 class="modal-title" id="detailsModalLabel">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <span id="modalTitleText">Details</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBodyContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
                <button type="button" class="btn btn-primary" id="modalActionButton" style="display: none;">@Localizer["ViewFullDetails"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@*     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
 *@    <script src="~/js/pages/dashboard.js"></script>
}