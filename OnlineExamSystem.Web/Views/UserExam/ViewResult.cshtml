@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model OnlineExamSystem.Domains.Entities.ExamSubmission

@{
    ViewData["Title"] = $"{Localizer["ExamResult"]} - {Model.Exam.Title}";
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
    var scorePercentage = Model.Score;
    var isPassed = Model.IsPassed;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Examify</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/pages/view-result.css" rel="stylesheet" />
</head>
<body>
    <div class="result-container">
        <div class="result-card">
            <div class="result-header @(!isPassed ? "failed" : "")">
                <div class="result-icon">
                    <i class="bi @(isPassed ? "bi-trophy-fill" : "bi-emoji-frown")"></i>
                </div>
                <h1 class="result-title">@(isPassed ? "Congratulations!" : "Keep Learning!")</h1>
                <p class="result-subtitle">@Model.Exam.Title</p>
                <p class="result-subtitle">@Model.SubmissionDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
            </div>

            <div class="score-section">
                <div class="score-circle">
                    <svg viewBox="0 0 200 200">
                        <defs>
                            <linearGradient id="scoreGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#3b82f6" />
                                <stop offset="100%" style="stop-color:#8b5cf6" />
                            </linearGradient>
                        </defs>
                        <circle cx="100" cy="100" r="80" class="bg-circle" />
                        <circle cx="100" cy="100" r="80" class="progress-circle" stroke="url(#scoreGradient)" />
                    </svg>
                    <div class="score-text">
                        <div class="score-value">@scorePercentage.ToString("F0")%</div>
                        <div class="score-label">Score</div>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value">@Model.CorrectAnswers</div>
                    <div class="stat-label">Correct Answers</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@(Model.TotalQuestions - Model.CorrectAnswers)</div>
                    <div class="stat-label">Incorrect Answers</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@Model.TotalQuestions</div>
                    <div class="stat-label">Total Questions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@scorePercentage.ToString("F0")%</div>
                    <div class="stat-label">Percentage</div>
                </div>
            </div>
        </div>

        <div class="result-card">
            <div class="answers-section">
                <h3 class="fw-bold mb-4"><i class="bi bi-list-check me-2"></i> Detailed Answers</h3>

                @{
                    int counter = 0;
                }
                @foreach (var answer in Model.Answers.OrderBy(a => a.QuestionId))
                {
                    counter++;
                    bool isCorrect = answer.SelectedChoiceId == answer.Question.CorrectChoiceId;
                    var correctChoice = answer.Question.Choices.FirstOrDefault(c => c.ChoiceId == answer.Question.CorrectChoiceId);
                    var selectedChoice = answer.SelectedChoice;

                    <div class="answer-card @(isCorrect ? "correct" : "incorrect")">
                        <div class="d-flex gap-3">
                            <div class="answer-status @(isCorrect ? "correct" : "incorrect")">
                                <i class="bi @(isCorrect ? "bi-check-lg" : "bi-x-lg")"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-semibold mb-2">Question @counter</h6>
                                <p class="mb-2">@answer.Question.Title</p>

                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <div class="choice-badge @(isCorrect ? "choice-correct" : "choice-wrong")">
                                            <i class="bi @(isCorrect ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                            Your answer: @(selectedChoice?.Text ?? "No answer selected")
                                        </div>
                                    </div>
                                    @if (!isCorrect)
                                    {
                                        <div class="col-md-6">
                                            <div class="choice-badge choice-correct">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Correct answer: @(correctChoice?.Text ?? "Not available")
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between gap-3 mt-4 pt-3">
                    <button onclick="window.print()" class="btn btn-outline-secondary" style="padding: 0.75rem 2rem; border-radius: 12px;">
                        <i class="bi bi-printer me-2"></i> Print Result
                    </button>
                    <a asp-controller="UserExam" asp-action="Index" class="btn btn-dashboard">
                        <i class="bi bi-journal-bookmark-fill me-2"></i> Back to Exams
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
        $('.progress-circle').each(function () {
        var percent = @scorePercentage;
        var radius = 80;
        var circumference = 2 * Math.PI * radius;
        var dashoffset = circumference - (percent / 100) * circumference;
        $(this).css('stroke-dashoffset', dashoffset);
        });
        });
    </script>
</body>
</html>