@model OnlineExamSystem.Application.DTOs.Exam.JoinExamDto
@{
    ViewData["Title"] = "Join Exam";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <i class="bi bi-box-arrow-in-right fs-1"></i>
                    <h3 class="mt-2 mb-0">Join Exam</h3>
                    <p class="mb-0 opacity-75">Enter your invitation code to start</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Join" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="InvitationCode" class="form-label fw-bold">
                                <i class="bi bi-key me-1"></i> Invitation Code
                            </label>
                            <input asp-for="InvitationCode"
                                   class="form-control form-control-lg text-uppercase"
                                   placeholder="Enter code (e.g., ABC123)"
                                   style="font-family: monospace; font-size: 1.2rem;"
                                   value="@Model.InvitationCode">
                            <span asp-validation-for="InvitationCode" class="text-danger"></span>
                            <small class="text-muted">Enter the 6-character code you received from your teacher</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StudentName" class="form-label fw-bold">
                                <i class="bi bi-person me-1"></i> Full Name
                            </label>
                            <input asp-for="StudentName" class="form-control" placeholder="Enter your full name">
                            <span asp-validation-for="StudentName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StudentEmail" class="form-label fw-bold">
                                <i class="bi bi-envelope me-1"></i> Email (Optional)
                            </label>
                            <input asp-for="StudentEmail" type="email" class="form-control" placeholder="your@email.com">
                            <span asp-validation-for="StudentEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="StudentId" class="form-label fw-bold">
                                <i class="bi bi-credit-card me-1"></i> Student ID (Optional)
                            </label>
                            <input asp-for="StudentId" class="form-control" placeholder="Student identification number">
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-play-circle-fill me-2"></i> Start Exam
                        </button>
                    </form>
                </div>
                <div class="card-footer bg-light text-center text-muted">
                    <small>Need help? Contact your teacher for assistance.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto uppercase invitation code
        $('#InvitationCode').on('input', function () {
            $(this).val($(this).val().toUpperCase());
        });
    </script>
}