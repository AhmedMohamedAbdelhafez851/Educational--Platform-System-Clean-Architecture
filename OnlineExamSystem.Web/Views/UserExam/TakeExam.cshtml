@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model OnlineExamSystem.Application.DTOs.Exam.TakeExamDto

@{
    ViewData["Title"] = $"{Localizer["TakeExam"]} - {Model.Title}";
    Layout = null;
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
    var examDuration = Model.DurationInMinutes * 60;
    var fingerprint = Guid.NewGuid().ToString();
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Examify</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/pages/take-exam.css" rel="stylesheet" />

    <!-- Additional styles for Unsure feature - No conflicts with existing -->
    <style>
            /* Unsure Button Styles */
            .btn-unsure {
                background: transparent;
                border: 1px solid #f59e0b;
                color: #f59e0b;
                padding: 0.25rem 0.75rem;
                border-radius: 2rem;
                font-size: 0.75rem;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.25rem;
            }

                .btn-unsure:hover {
                    background: #fffbeb;
                    transform: scale(1.02);
                }

                .btn-unsure.active {
                    background: #f59e0b;
                    color: white;
                    border-color: #f59e0b;
                }

                .btn-unsure i {
                    font-size: 0.75rem;
                }

            /* Question Card Unsure State */
            .question-card.unsure {
                border-left: 4px solid #f59e0b;
                background: #fffbeb;
            }

            .question-card.answered.unsure {
                border-left: 4px solid #10b981;
                background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);
                border-right: 2px solid #f59e0b;
            }

            /* Navigator Unsure State */
            .nav-question.unsure {
                background: #f59e0b;
                border-color: #f59e0b;
                color: white;
            }

            .nav-question.answered.unsure {
                background: linear-gradient(135deg, #10b981 0%, #f59e0b 100%);
                border-color: #10b981;
                color: white;
                position: relative;
            }

                .nav-question.answered.unsure::after {
                    content: '?';
                    position: absolute;
                    top: -5px;
                    right: -5px;
                    background: #f59e0b;
                    color: white;
                    font-size: 8px;
                    width: 14px;
                    height: 14px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: bold;
                }

            /* Navigator Legend */
            .nav-legend {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
                margin-bottom: 1rem;
                padding-bottom: 0.75rem;
                border-bottom: 1px solid #e5e7eb;
            }

            .legend-item {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.75rem;
                color: #6b7280;
            }

            .legend-box {
                width: 24px;
                height: 24px;
                border-radius: 8px;
                border: 2px solid #e5e7eb;
            }

                .legend-box.answered {
                    background: #10b981;
                    border-color: #10b981;
                }

                .legend-box.unsure {
                    background: #f59e0b;
                    border-color: #f59e0b;
                }

                .legend-box.answered-unsure {
                    background: linear-gradient(135deg, #10b981 0%, #f59e0b 100%);
                    border-color: #10b981;
                }

                .legend-box.current {
                    background: #3b82f6;
                    border-color: #3b82f6;
                }

            /* Question Header Layout */
            .question-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 1rem;
                flex-wrap: wrap;
                gap: 0.5rem;
            }

            .question-title-wrapper {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
            }

            .question-badge {
                background: #6366f1;
                color: white;
                border-radius: 2rem;
                padding: 0.25rem 0.75rem;
                font-size: 0.75rem;
                font-weight: 600;
            }

            .question-title {
                font-size: 1rem;
                font-weight: 600;
                color: #1f2937;
                margin: 0;
            }

            /* RTL Support for Unsure Feature */
            body[dir="rtl"] .question-card.unsure {
                border-left: 2px solid #e5e7eb;
                border-right: 4px solid #f59e0b;
            }

            body[dir="rtl"] .question-card.answered.unsure {
                border-left: 2px solid #f59e0b;
                border-right: 4px solid #10b981;
            }

            body[dir="rtl"] .nav-question.answered.unsure::after {
                right: auto;
                left: -5px;
            }

            /* Unsure Progress Bar */
            .unsure-progress {
                margin-top: 0.5rem;
            }

                .unsure-progress .progress-bar {
                    background: #f59e0b;
                }
    </style>
</head>
<body>
    <div class="exam-container">
        <!-- Header -->
        <div class="exam-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="exam-title">@Model.Title</h1>
                    <p class="text-muted mb-0">
                        <i class="bi bi-question-circle"></i> @Localizer["QuestionsCount"]: @Model.Questions.Count
                    </p>
                    <p class="text-muted mb-0">
                        <i class="bi bi-clock-history"></i> @Localizer["Duration"]: @Model.DurationInMinutes @Localizer["Minutes"]
                    </p>
                </div>
                <div class="col-md-4">
                    <div class="timer-card" id="timerCard">
                        <div class="timer-label"><i class="bi bi-hourglass-split"></i> @Localizer["TimeRemaining"]</div>
                        <div class="timer-value" id="timeDisplay">--:--</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Questions Area -->
            <div class="col-lg-8">
                <form id="examForm">
                    <input type="hidden" name="examId" value="@Model.ExamId" />
                    <input type="hidden" name="attemptId" value="@ViewBag.AttemptId" />
                    <input type="hidden" name="fingerprint" id="fingerprint" value="@fingerprint" />

                    <div id="questionsContainer">
                        @foreach (var question in Model.Questions.OrderBy(q => q.QuestionId))
                        {
                            var questionIndex = Model.Questions.ToList().IndexOf(question);
                            <div class="question-card" data-question-id="@question.QuestionId" data-index="@questionIndex" id="question-card-@question.QuestionId">
                                <div class="question-header">
                                    <div class="question-title-wrapper">
                                        <span class="question-badge">@Localizer["Question"] @(questionIndex + 1)</span>
                                        <h5 class="question-title">@question.Title</h5>
                                    </div>
                                    <div class="question-actions">
                                        <button type="button" class="btn-unsure unsure-btn" data-question-id="@question.QuestionId">
                                            <i class="bi bi-question-lg"></i>
                                            <span>@Localizer["Unsure"]</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="choices-container">
                                    @foreach (var choice in question.Choices.OrderBy(c => c.ChoiceId))
                                    {
                                        <div class="choice-item" data-choice-id="@choice.ChoiceId" data-question-id="@question.QuestionId">
                                            <input type="radio"
                                                   name="q_@question.QuestionId"
                                                   value="@choice.ChoiceId"
                                                   id="q_@(question.QuestionId)_@(choice.ChoiceId)"
                                                   class="choice-radio"
                                                   style="display: none;" />
                                            <label for="q_@(question.QuestionId)_@(choice.ChoiceId)" style="cursor: pointer; width: 100%; display: block; margin: 0;">
                                                @choice.Text
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="text-center mt-4">
                        <button type="button" class="btn btn-success btn-lg submit-btn" id="submitExamBtn">
                            <i class="bi bi-check2-circle me-2"></i> @Localizer["SubmitExam"]
                        </button>
                    </div>
                </form>
            </div>

            <!-- Navigator Sidebar -->
            <div class="col-lg-4">
                <div class="exam-header">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> @Localizer["QuestionNavigator"]
                    </h6>

                    <!-- Legend for colors -->
                    <div class="nav-legend">
                        <div class="legend-item">
                            <div class="legend-box answered"></div>
                            <span>@Localizer["Answered"]</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-box unsure"></div>
                            <span>@Localizer["Unsure"]</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-box answered-unsure"></div>
                            <span>@Localizer["AnsweredUnsure"]</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-box current"></div>
                            <span>@Localizer["Current"]</span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2" id="questionNavigator">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            <div class="nav-question" data-index="@i" data-question-id="@Model.Questions[i].QuestionId">
                                @(i + 1)
                            </div>
                        }
                    </div>

                    <hr class="my-3" />

                    <!-- Answered Progress -->
                    <div class="d-flex justify-content-between">
                        <span><i class="bi bi-check-circle-fill text-success"></i> @Localizer["Answered"]</span>
                        <span id="answeredCount">0 / @Model.Questions.Count</span>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div id="answeredProgress" class="progress-bar bg-success" style="width: 0%"></div>
                    </div>

                    <hr class="my-3" />

                    <!-- Unsure Progress (NEW) -->
                    <div class="d-flex justify-content-between">
                        <span><i class="bi bi-question-circle-fill text-warning"></i> @Localizer["UnsureQuestions"]</span>
                        <span id="unsureCount">0 / @Model.Questions.Count</span>
                    </div>
                    <div class="progress mt-2 unsure-progress" style="height: 6px;">
                        <div id="unsureProgress" class="progress-bar" style="width: 0%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="exam-footer">
            <small><i class="bi bi-shield-check"></i> @Localizer["SecurityMessage"]</small>
        </div>
    </div>

    <!-- Time Overlay -->
    <div id="timeOverlay" class="time-overlay" style="display: none;">
        <div class="text-center">
            <i class="bi bi-hourglass-bottom" style="font-size: 4rem;"></i>
            <h2 class="mt-3">@Localizer["TimeIsUp"]</h2>
            <p>@Localizer["AutoSubmitting"]</p>
            <div class="spinner-border mt-3" role="status"></div>
        </div>
    </div>

    <!-- Fullscreen Badge -->
    <div class="fullscreen-badge" id="fullscreenBadge">
        <i class="bi bi-arrows-fullscreen"></i> <span id="fullscreenText">@Localizer["FullscreenRecommended"]</span>
    </div>

    <div class="security-note">
        <i class="bi bi-shield-lock"></i> @Localizer["SecureExam"]
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
        // =====================================================
        // CONFIGURATION
        // =====================================================
        var examDurationSeconds = @examDuration;
        var totalQuestions = @Model.Questions.Count;
        var timeLeft = examDurationSeconds;
        var answeredQuestions = new Array(totalQuestions).fill(false);
        var unsureQuestions = new Array(totalQuestions).fill(false);
        var userAnswers = {};
        var timerInterval;
        var isSubmitting = false;
        var hasSubmitted = false;
        var tabSwitchCount = 0;
        var visibilityWarnings = [];

        // =====================================================
        // GENERATE DEVICE FINGERPRINT
        // =====================================================
        function generateDeviceFingerprint() {
        var fingerprint = {
        userAgent: navigator.userAgent,
        language: navigator.language,
        platform: navigator.platform,
        screenResolution: screen.width + 'x' + screen.height,
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
        touchSupport: 'ontouchstart' in window
        };
        return btoa(JSON.stringify(fingerprint));
        }

        var deviceFingerprint = generateDeviceFingerprint();
        $('#fingerprint').val(deviceFingerprint);

        // =====================================================
        // FULLSCREEN FUNCTIONALITY
        // =====================================================
        function toggleFullscreen() {
        if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(err => {
        console.log('Fullscreen not supported');
        });
        $('#fullscreenText').text('@Localizer["ExitFullscreen"]');
        } else {
        document.exitFullscreen();
        $('#fullscreenText').text('@Localizer["FullscreenRecommended"]');
        }
        }

        $('#fullscreenBadge').click(toggleFullscreen);

        document.addEventListener('fullscreenchange', function () {
        if (document.fullscreenElement) {
        $('#fullscreenText').text('@Localizer["ExitFullscreen"]');
        } else {
        $('#fullscreenText').text('@Localizer["FullscreenRecommended"]');
        }
        });

        // =====================================================
        // SAVE & RESTORE ANSWERS
        // =====================================================
        var savedAnswers = sessionStorage.getItem('exam_@Model.ExamId');
        var savedUnsure = sessionStorage.getItem('exam_unsure_@Model.ExamId');

        if (savedAnswers) {
        userAnswers = JSON.parse(savedAnswers);
        for (var qId in userAnswers) {
        var questionCard = $('.question-card[data-question-id="' + qId + '"]');
        if (questionCard.length) {
        var index = questionCard.data('index');
        answeredQuestions[index] = true;
        var choiceId = userAnswers[qId];
        var choiceItem = $('.choice-item[data-question-id="' + qId + '"][data-choice-id="' + choiceId + '"]');
        choiceItem.addClass('selected');
        choiceItem.find('.choice-radio').prop('checked', true);
        updateQuestionCardStyle(questionCard, index);
        }
        }
        }

        if (savedUnsure) {
        var unsureData = JSON.parse(savedUnsure);
        for (var i = 0; i < unsureData.length; i++) {
        if (unsureData[i]) {
        unsureQuestions[i] = true;
        var questionCard = $('.question-card[data-index="' + i + '"]');
        if (questionCard.length) {
        updateQuestionCardStyle(questionCard, i);
        }
        }
        }
        updateUnsureCount();
        }

        function saveAnswers() {
        if (!hasSubmitted) {
        sessionStorage.setItem('exam_@Model.ExamId', JSON.stringify(userAnswers));
        sessionStorage.setItem('exam_unsure_@Model.ExamId', JSON.stringify(unsureQuestions));
        }
        }

        function clearAnswers() {
        sessionStorage.removeItem('exam_@Model.ExamId');
        sessionStorage.removeItem('exam_unsure_@Model.ExamId');
        }

        // =====================================================
        // UPDATE QUESTION CARD STYLES
        // =====================================================
        function updateQuestionCardStyle(questionCard, index) {
        var isAnswered = answeredQuestions[index];
        var isUnsure = unsureQuestions[index];

        questionCard.removeClass('answered unsure');

        if (isAnswered && isUnsure) {
        questionCard.addClass('answered unsure');
        } else if (isAnswered) {
        questionCard.addClass('answered');
        } else if (isUnsure) {
        questionCard.addClass('unsure');
        }

        var navButton = $('.nav-question[data-index="' + index + '"]');
        navButton.removeClass('answered unsure');

        if (isAnswered && isUnsure) {
        navButton.addClass('answered unsure');
        } else if (isAnswered) {
        navButton.addClass('answered');
        } else if (isUnsure) {
        navButton.addClass('unsure');
        } else {
        navButton.removeClass('answered unsure');
        }
        }

        // =====================================================
        // UNSURE BUTTON HANDLER
        // =====================================================
        $('.unsure-btn').click(function (e) {
        e.stopPropagation();
        if (isSubmitting || hasSubmitted) return;

        var questionId = $(this).data('question-id');
        var questionCard = $('.question-card[data-question-id="' + questionId + '"]');
        var index = questionCard.data('index');

        unsureQuestions[index] = !unsureQuestions[index];
        updateQuestionCardStyle(questionCard, index);
        updateUnsureCount();
        saveAnswers();

        var $btn = $(this);
        if (unsureQuestions[index]) {
        $btn.addClass('active');
        showGentleNotification('@Localizer["Info"]', '@Localizer["QuestionMarkedUnsure"]', 'info');
        } else {
        $btn.removeClass('active');
        showGentleNotification('@Localizer["Info"]', '@Localizer["UnsureRemoved"]', 'info');
        }
        });

        function updateUnsureCount() {
        var unsure = unsureQuestions.filter(function (v) { return v; }).length;
        $('#unsureCount').text(unsure + ' / ' + totalQuestions);
        $('#unsureProgress').css('width', (unsure / totalQuestions * 100) + '%');
        }

        // =====================================================
        // TIMER
        // =====================================================
        function startTimer() {
        updateTimerDisplay();
        timerInterval = setInterval(function () {
        if (timeLeft <= 0) {
        clearInterval(timerInterval);
        if (!isSubmitting && !hasSubmitted) {
        submitExam(true);
        }
        } else {
        timeLeft--;
        updateTimerDisplay();

        if (timeLeft <= examDurationSeconds * 0.3 && !$('#timerCard').hasClass('warning')) {
        $('#timerCard').addClass('warning');
        }
        if (timeLeft <= examDurationSeconds * 0.1 && !$('#timerCard').hasClass('danger')) {
        $('#timerCard').removeClass('warning').addClass('danger');
        }
        }
        }, 1000);
        }

        function updateTimerDisplay() {
        var minutes = Math.floor(timeLeft / 60);
        var seconds = timeLeft % 60;
        var timeString = minutes.toString().padStart(2, '0') + ':' + seconds.toString().padStart(2, '0');
        $('#timeDisplay').text(timeString);
        document.title = '(' + timeString + ') ' + '@Model.Title';
        }

        function updateAnsweredCount() {
        var answered = answeredQuestions.filter(function (v) { return v; }).length;
        $('#answeredCount').text(answered + ' / ' + totalQuestions);
        $('#answeredProgress').css('width', (answered / totalQuestions * 100) + '%');
        }

        // =====================================================
        // ANSWER SELECTION
        // =====================================================
        $('.choice-item').click(function () {
        if (isSubmitting || hasSubmitted) return;

        var $choice = $(this);
        var questionId = $choice.data('question-id');
        var choiceId = $choice.data('choice-id');
        var questionCard = $('.question-card[data-question-id="' + questionId + '"]');
        var questionIndex = questionCard.data('index');

        $choice.find('.choice-radio').prop('checked', true);
        $choice.closest('.choices-container').find('.choice-item').removeClass('selected');
        $choice.addClass('selected');

        answeredQuestions[questionIndex] = true;
        userAnswers[questionId] = choiceId;

        updateQuestionCardStyle(questionCard, questionIndex);
        saveAnswers();

        updateAnsweredCount();
        });

        // =====================================================
        // QUESTION NAVIGATOR
        // =====================================================
        $('.nav-question').click(function () {
        var index = $(this).data('index');
        $('.nav-question').removeClass('current');
        $(this).addClass('current');
        $('html, body').animate({
        scrollTop: $('.question-card[data-index="' + index + '"]').offset().top - 100
        }, 500);
        setTimeout(function () {
        $('.nav-question').removeClass('current');
        }, 1500);
        });

        // =====================================================
        // SUBMIT EXAM
        // =====================================================
        function submitExam(isAutoSubmit) {
        if (isSubmitting || hasSubmitted) return;
        isSubmitting = true;
        hasSubmitted = true;

        if (isAutoSubmit) {
        $('#timeOverlay').css('display', 'flex');
        }

        var $btn = $('#submitExamBtn');
        var originalText = $btn.html();
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Submitting"]...');

        // Collect unsure questions for analytics
        var unsureData = [];
        for (var i = 0; i < totalQuestions; i++) {
        if (unsureQuestions[i]) {
        var questionCard = $('.question-card[data-index="' + i + '"]');
        if (questionCard.length) {
        unsureData.push({
        questionId: questionCard.data('question-id'),
        questionIndex: i
        });
        }
        }
        }

        $.ajax({
        url: '@Url.Action("SubmitExam", "UserExam")',
        type: 'POST',
        data: {
        examId: @Model.ExamId,
        answers: userAnswers,
        attemptId: '@ViewBag.AttemptId',
        fingerprint: deviceFingerprint,
        unsureQuestions: JSON.stringify(unsureData)
        },
        success: function (response) {
        if (response.success) {
        clearAnswers();
        window.location.href = '@Url.Action("ViewResult", "UserExam")/' + response.submissionId;
        } else {
        showGentleNotification('@Localizer["SubmitError"]', response.message, 'error');
        $btn.prop('disabled', false).html(originalText);
        isSubmitting = false;
        hasSubmitted = false;
        if (isAutoSubmit) $('#timeOverlay').hide();
        }
        },
        error: function (xhr) {
        showGentleNotification('@Localizer["SubmitError"]', '@Localizer["PleaseTryAgain"]', 'error');
        $btn.prop('disabled', false).html(originalText);
        isSubmitting = false;
        hasSubmitted = false;
        if (isAutoSubmit) $('#timeOverlay').hide();
        }
        });
        }

        function showGentleNotification(title, message, type) {
        var bgClass = type === 'error' ? 'bg-danger' : (type === 'info' ? 'bg-info' : 'bg-success');
        var toastHtml = '<div class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 9999; margin-top: 70px;">' +
        '<div class="toast align-items-center text-white ' + bgClass + ' border-0 show" role="alert">' +
        '<div class="d-flex"><div class="toast-body"><strong>' + title + '</strong><br>' + message + '</div>' +
        '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div></div>';
        $('body').append(toastHtml);
        setTimeout(function () { $('.position-fixed').last().remove(); }, 3000);
        }

        $('#submitExamBtn').click(function () { submitExam(false); });

        // =====================================================
        // ANTI-CHEATING MEASURES
        // =====================================================
        document.addEventListener('visibilitychange', function () {
        if (document.hidden && timeLeft > 0 && !isSubmitting && !hasSubmitted) {
        tabSwitchCount++;
        visibilityWarnings.push({
        timestamp: new Date().toISOString(),
        type: 'tab_switch',
        count: tabSwitchCount
        });
        sessionStorage.setItem('examViolations', JSON.stringify(visibilityWarnings));

        if (tabSwitchCount >= 5) {
        showGentleNotification('@Localizer["Warning"]', '@Localizer["MultipleTabSwitches"]', 'warning');
        }
        if (tabSwitchCount >= 10 && !hasSubmitted) {
        showGentleNotification('@Localizer["Warning"]', '@Localizer["AutoSubmitWarning"]', 'warning');
        setTimeout(function () { submitExam(true); }, 2000);
        }
        }
        });

        // Prevent right-click
        document.addEventListener('contextmenu', function (e) { e.preventDefault(); return false; });

        // Prevent keyboard shortcuts
        document.addEventListener('keydown', function (e) {
        if (e.key === 'F12') { e.preventDefault(); return false; }
        if (e.ctrlKey && e.shiftKey && e.key === 'I') { e.preventDefault(); return false; }
        if (e.ctrlKey && e.key === 'u') { e.preventDefault(); return false; }
        if (e.ctrlKey && e.key === 's') { e.preventDefault(); return false; }
        if (e.ctrlKey && e.key === 'p') { e.preventDefault(); return false; }
        });

        // Page leave warning
        window.addEventListener('beforeunload', function (e) {
        if (Object.keys(userAnswers).length > 0 && timeLeft > 0 && !isSubmitting && !hasSubmitted) {
        var confirmationMessage = '@Localizer["UnsavedWarning"]';
        e.returnValue = confirmationMessage;
        return confirmationMessage;
        }
        });

        // Auto-save every 30 seconds
        setInterval(function () {
        if (Object.keys(userAnswers).length > 0 && !hasSubmitted) {
        saveAnswers();
        }
        }, 30000);

        // Initialize
        startTimer();
        updateAnsweredCount();
        updateUnsureCount();

        // Mark current question on load
        $('.nav-question[data-index="0"]').addClass('current');
        });
    </script>
</body>
</html>