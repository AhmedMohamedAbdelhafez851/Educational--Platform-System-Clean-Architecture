@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model IEnumerable<OnlineExamSystem.Application.DTOs.Question.CreateQuestionDto>

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var examTitle = ViewBag.ExamTitle;
    var examId = ViewBag.ExamId;
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
    var totalQuestions = Model?.Count() ?? 0;
}

@section Styles {
    <link href="~/css/pages/questions.css" rel="stylesheet" />
}

<div class="questions-page">
    <!-- Header -->
    <div class="page-header">
        <div>
            <div class="page-title-wrapper">
                <i class="bi bi-question-circle-fill page-icon"></i>
                <h1 class="page-title">@Localizer["ExamQuestions"]</h1>
            </div>
            <div class="exam-info">
                <i class="bi bi-journal-bookmark-fill"></i>
                <span>@examTitle</span>
                <span class="separator">•</span>
                <i class="bi bi-list-check"></i>
                <span>@Localizer["TotalQuestions"]: @totalQuestions</span>
            </div>
        </div>
        <div class="header-actions">
            <a asp-controller="Exam" asp-action="Index" class="btn btn-outline-custom">
                <i class="bi bi-arrow-left"></i>
                <span>@Localizer["BackToExams"]</span>
            </a>
            <a asp-controller="Question" asp-action="Add" asp-route-examId="@examId" class="btn btn-primary-custom">
                <i class="bi bi-plus-circle"></i>
                <span>@Localizer["AddQuestion"]</span>
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-question-octagon"></i>
            </div>
            <h3>@Localizer["NoQuestions"]</h3>
            <p>@Localizer["NoQuestionsMessage"]</p>
            <a asp-controller="Question" asp-action="Add" asp-route-examId="@examId" class="btn btn-primary-custom mt-3">
                <i class="bi bi-plus-circle"></i> @Localizer["AddFirstQuestion"]
            </a>
        </div>
    }
    else
    {
        <div class="questions-grid">
            @foreach (var question in Model)
            {
                <div class="question-card" id="question-card-@question.QuestionId">
                    <div class="question-header">
                        <div class="question-number">
                            <span class="number">@(Model.ToList().IndexOf(question) + 1)</span>
                        </div>
                        <div class="question-title">
                            <h4>@question.Title</h4>
                        </div>
                        <div class="question-actions">
                            <a asp-controller="Question" asp-action="Edit" asp-route-id="@question.QuestionId" asp-route-examId="@examId"
                               class="action-btn edit-btn" title="@Localizer["EditQuestion"]">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <button type="button" class="action-btn delete-btn delete-question-btn"
                                    data-id="@question.QuestionId" data-exam-id="@examId"
                                    title="@Localizer["DeleteQuestion"]">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>
                    <div class="question-body">
                        <div class="choices-list">
                            @foreach (var choice in question.Choices)
                            {
                                <div class="choice-item @(choice.IsCorrect ? "correct-choice" : "")">
                                    <div class="choice-marker">
                                        @if (choice.IsCorrect)
                                        {
                                            <i class="bi bi-check-circle-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle"></i>
                                        }
                                    </div>
                                    <div class="choice-text">@choice.Text</div>
                                    @if (choice.IsCorrect)
                                    {
                                        <span class="correct-badge">@Localizer["Correct"]</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header custom-modal-header modal-danger-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @Localizer["ConfirmDeletion"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="delete-warning">
                    <i class="bi bi-trash3-fill"></i>
                    <h4>@Localizer["DeleteQuestionTitle"]</h4>
                    <p>@Localizer["DeleteConfirmation"]</p>
                    <div class="warning-note">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@Localizer["DeleteWarning"]</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer custom-modal-footer">
                <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> @Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-danger-custom" id="confirmDeleteQuestion">
                    <i class="bi bi-trash3"></i> @Localizer["Delete"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isRtl = @(isRtl ? "true" : "false");

            // Delete question functionality
            var currentQuestionId = null;
            var currentExamId = null;

            $(".delete-question-btn").click(function () {
                currentQuestionId = $(this).data("id");
                currentExamId = $(this).data("exam-id");
                $("#deleteQuestionModal").modal("show");
            });

            $("#confirmDeleteQuestion").click(function () {
                var $btn = $(this);
                $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Deleting"]...');

                $.ajax({
                    url: '@Url.Action("Delete", "Question")',
                    type: 'POST',
                    data: { id: currentQuestionId, examId: currentExamId },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        $("#deleteQuestionModal").modal("hide");
                        if (response.success) {
                            $("#question-card-" + currentQuestionId).fadeOut(300, function () {
                                $(this).remove();
                                if ($(".questions-grid .question-card").length === 0) {
                                    location.reload();
                                } else {
                                    // Renumber remaining questions
                                    $(".question-card").each(function (index) {
                                        $(this).find(".question-number .number").text(index + 1);
                                    });
                                }
                            });
                            showToast("success", "@Localizer["Success"]", "@Localizer["QuestionDeleted"]");
                        } else {
                            showToast("error", "@Localizer["Error"]", response.message || "@Localizer["DeleteFailed"]");
                        }
                        $btn.prop("disabled", false).html('<i class="bi bi-trash3"></i> @Localizer["Delete"]');
                    },
                    error: function () {
                        $("#deleteQuestionModal").modal("hide");
                        showToast("error", "@Localizer["Error"]", "@Localizer["DeleteWarning"]");
                        $btn.prop("disabled", false).html('<i class="bi bi-trash3"></i> @Localizer["Delete"]');
                    }
                });
            });

            function showToast(type, title, message) {
                var toastId = 'toast-' + Date.now();
                var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
                var iconClass = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';

                var toastHtml = '<div id="' + toastId + '" class="toast align-items-center border-0 ' + bgClass + ' text-white show" role="alert">' +
                    '<div class="d-flex">' +
                    '<div class="toast-body d-flex align-items-center">' +
                    '<i class="bi ' + iconClass + ' me-2"></i>' +
                    '<div><strong>' + title + '</strong><div>' + message + '</div></div>' +
                    '</div>' +
                    '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
                    '</div>' +
                    '</div>';

                $('.toast-container').append(toastHtml);
                var toastElement = document.getElementById(toastId);
                var toast = new bootstrap.Toast(toastElement, { autohide: true, delay: 5000 });
                toast.show();
                $(toastElement).on('hidden.bs.toast', function () { $(this).remove(); });
            }
        });
    </script>
}