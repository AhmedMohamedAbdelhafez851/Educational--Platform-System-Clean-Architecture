@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model OnlineExamSystem.Application.DTOs.Question.CreateQuestionDto

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0">@Localizer["EditQuestion"]</h3>
                <small class="text-white-50">@Localizer["ExamLabel"]: @ViewBag.ExamTitle</small>
            </div>
            <a asp-controller="Question" asp-action="Index" asp-route-examId="@Model.ExamId" class="btn btn-outline-light">
                <i class="bi bi-arrow-left"></i> @Localizer["BackToQuestions"]
            </a>
        </div>
        <div class="card-body">
            <form id="editForm" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="QuestionId" />
                <input type="hidden" asp-for="ExamId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: none;"></div>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold">@Localizer["QuestionText"]</label>
                    <textarea asp-for="Title" class="form-control" rows="3"
                              data-val="true" data-val-required="@Localizer["QuestionTextRequired"]"
                              data-val-minlength="@Localizer["QuestionMinLength"]"
                              data-val-minlength-min="5"></textarea>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">@Localizer["AnswerChoices"]</h5>
                        <small class="text-muted">@Localizer["ChoicesHelp"]</small>
                    </div>
                    <div class="card-body">
                        @for (int i = 0; i < Model.Choices.Count; i++)
                        {
                            <div class="mb-3 p-3 border rounded @(Model.CorrectChoiceIndex == i ? "border-success bg-success bg-opacity-10" : "")">
                                <div class="row align-items-center">
                                    <div class="col-auto">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="CorrectChoiceIndex" value="@i"
                                                   id="choice@(i)" @(Model.CorrectChoiceIndex == i ? "checked" : "")>
                                            <label class="form-check-label" for="choice@(i)">
                                                @Localizer["OptionIsCorrect"]
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <input type="hidden" asp-for="Choices[i].ChoiceId" />
                                        <input asp-for="Choices[i].Text" class="form-control" placeholder="@Localizer["OptionPlaceholder"]"
                                               data-val="true" data-val-required="@Localizer["ChoiceRequired"]" />
                                        <span asp-validation-for="Choices[i].Text" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Question" asp-action="Index" asp-route-examId="@Model.ExamId" class="btn btn-secondary">
                        @Localizer["Cancel"]
                    </a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="bi bi-save"></i> @Localizer["SaveChanges"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Initialize form validation
            $("#editForm").validate({
                rules: {
                    "Title": {
                        required: true,
                        minlength: 5
                    }
                },
                messages: {
                    "Title": {
                        required: "@Localizer["QuestionTextRequired"]",
                        minlength: "@Localizer["QuestionMinLength"]"
                    }
                },
                errorClass: "is-invalid",
                validClass: "is-valid",
                submitHandler: function (form) {
                    var $btn = $("#submitBtn");
                    $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> @Localizer["SaveChanges"]...');
                    form.submit();
                }
            });

            // Highlight selected answer choice
            $('input[name="CorrectChoiceIndex"]').change(function () {
                $('.border').removeClass('border-success bg-success bg-opacity-10');
                $(this).closest('.border').addClass('border-success bg-success bg-opacity-10');
            });

            // Real-time validation for choice texts
            $("input[name$='.Text']").on("input blur", function () {
                if ($(this).val().trim() === "") {
                    $(this).addClass("is-invalid");
                } else {
                    $(this).removeClass("is-invalid").addClass("is-valid");
                }
            });
        });
    </script>
}