@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model OnlineExamSystem.Application.DTOs.Analytics.ExamAnalyticsDto

<div class="insights-grid">
    <div class="insight-card" data-target="attention">
        <div class="insight-icon" style="background: #fef2f2; color: #ef4444;">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div class="insight-content">
            <div class="insight-title">@Localizer["AtRiskStudents"]</div>
            <div class="insight-message">@Model.StrugglingStudents.Count @Localizer["NeedImmediateAttention"]</div>
            <div class="insight-action">@Localizer["ViewDetails"] →</div>
        </div>
    </div>

    <div class="insight-card">
        <div class="insight-icon" style="background: #eff6ff; color: #3b82f6;">
            <i class="bi bi-question-circle"></i>
        </div>
        <div class="insight-content">
            <div class="insight-title">@Localizer["DifficultQuestions"]</div>
            <div class="insight-message">
                @(Model.DifficultQuestions.FirstOrDefault()?.QuestionText?.Substring(0, Math.Min(50, Model.DifficultQuestions.FirstOrDefault()?.QuestionText?.Length ?? 0)) ?? @Localizer["NoData"].Value)
            </div>
            <div class="insight-action">@Localizer["ReviewQuestions"] →</div>
        </div>
    </div>

    <div class="insight-card">
        <div class="insight-icon" style="background: #f0fdf4; color: #10b981;">
            <i class="bi bi-star"></i>
        </div>
        <div class="insight-content">
            <div class="insight-title">@Localizer["TopPerformers"]</div>
            <div class="insight-message">@Model.TopStudents.Count @Localizer["ScoredAboveAverage"]</div>
            <div class="insight-action">@Localizer["ViewRecognition"] →</div>
        </div>
    </div>
</div>