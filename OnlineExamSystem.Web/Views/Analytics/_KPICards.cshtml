@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model OnlineExamSystem.Application.DTOs.Analytics.ExamAnalyticsDto

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-header">
            <span class="kpi-label">@Localizer["TotalStudents"]</span>
            <div class="kpi-icon" style="background: #eff6ff; color: #3b82f6;">
                <i class="bi bi-people"></i>
            </div>
        </div>
        <div class="kpi-value">@Model.TotalStudents</div>
        <div class="kpi-trend">
            <span class="trend-up"><i class="bi bi-check-circle-fill"></i> @Localizer["Attended"]: @Model.StudentsAttended</span>
            <span class="trend-down"><i class="bi bi-x-circle-fill"></i> @Localizer["Absent"]: @Model.StudentsNotAttended</span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-header">
            <span class="kpi-label">@Localizer["AverageScore"]</span>
            <div class="kpi-icon" style="background: #f0fdf4; color: #10b981;">
                <i class="bi bi-trophy"></i>
            </div>
        </div>
        <div class="kpi-value">@Model.AverageScore.ToString("F1")%</div>
        <div class="kpi-trend">
            <span>@Localizer["Highest"]: @Model.HighestScore.ToString("F1")%</span>
            <span>@Localizer["Lowest"]: @Model.LowestScore.ToString("F1")%</span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-header">
            <span class="kpi-label">@Localizer["PassRate"]</span>
            <div class="kpi-icon" style="background: #eff6ff; color: #3b82f6;">
                <i class="bi bi-bar-chart"></i>
            </div>
        </div>
        <div class="kpi-value">@Model.PassRate.ToString("F1")%</div>
        <div class="kpi-trend">
            <span class="@(Model.PassRate >= 70 ? "trend-up" : "trend-down")">
                @(Model.StudentsAttended - (int)(Model.StudentsAttended * Model.PassRate / 100)) @Localizer["Failed"]
            </span>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-header">
            <span class="kpi-label">@Localizer["AttendanceRate"]</span>
            <div class="kpi-icon" style="background: #fef3c7; color: #f59e0b;">
                <i class="bi bi-calendar-check"></i>
            </div>
        </div>
        <div class="kpi-value">@Model.AttendanceRate.ToString("F1")%</div>
        <div class="kpi-trend">@Model.StudentsAttended @Localizer["Participated"] @Localizer["TotalStudents"]</div>
    </div>
</div>