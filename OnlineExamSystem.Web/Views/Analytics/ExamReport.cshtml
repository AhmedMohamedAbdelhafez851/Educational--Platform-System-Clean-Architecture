@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model OnlineExamSystem.Application.DTOs.Analytics.ExamAnalyticsDto

@{
    ViewData["Title"] = string.Format(Localizer["PageTitle"].Value, Model.ExamTitle);
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
}
<link rel="stylesheet" href="~/css/analytics/ExamReport.css" />

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="header-title">@Localizer["ExamAnalytics"]</h1>
        <p class="header-subtitle">@Localizer["Subtitle"]</p>
        <div class="exam-badge">
            <i class="bi bi-journal-bookmark-fill"></i>
            <span>@Model.ExamTitle</span>
        </div>
    </div>

    <partial name="_KPICards" model="Model" />
    <partial name="_SmartInsights" model="Model" />
    <partial name="_Charts" model="Model" />
    <partial name="_AttentionStudents" model="Model" />
    <partial name="_TopStudentsTable" model="Model" />
    <partial name="_AttendanceTable" model="Model" />
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.scoreDistribution = @Html.Raw(Json.Serialize(Model.ScoreDistribution));
        window.localization = {
        students: '@Localizer["Students"]',
        scoreRange: '@Localizer["ScoreRange"]'
        };
    </script>
    <script src="~/js/analytics/ExamReport.js"></script>
}