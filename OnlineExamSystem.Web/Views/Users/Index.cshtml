</div>

<!-- ===================================================== -->
<!-- MANAGE USER ROLES MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="manageRolesModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content custom-modal">

            <div class="modal-header custom-modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-person-gear"></i>

                    @Localizer["ManageRoles"]

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="manageRolesForm">

                <input type="hidden"
                       id="manageRolesUserId"
                       name="UserId" />

                <div class="modal-body">

                    <h5 id="manageRolesUserName"
                        class="mb-4">
                    </h5>

                    <div id="rolesCheckboxList"></div>

                </div>

                <div class="modal-footer custom-modal-footer">

                    <button type="button"
                            class="btn btn-light-custom"
                            data-bs-dismiss="modal">

                        @Localizer["Cancel"]

                    </button>

                    <button type="submit"
                            class="btn btn-primary-custom"
                            id="rolesBtn">

                        <i class="bi bi-save"></i>

                        @Localizer["Save"]

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- DELETE USER MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">

                    <i class="bi bi-trash3"></i>

                    @Localizer["DeleteUser"]

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="deleteUserForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="deleteUserId"
                       name="id" />

                <div class="modal-body">

                    <p>

                        @Localizer["DeleteConfirmation"]

                        <strong id="userNameToDelete"></strong>

                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        @Localizer["Cancel"]

                    </button>

                    <button type="submit"
                            class="btn btn-danger"
                            id="confirmDelete">

                        <i class="bi bi-trash3"></i>

                        @Localizer["Delete"]

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- TOAST -->
<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        // =====================================================
        // MODAL INSTANCES
        // =====================================================

        const createModal = new bootstrap.Modal(document.getElementById("createUserModal"));
        const editModal = new bootstrap.Modal(document.getElementById("editUserModal"));
        const rolesModal = new bootstrap.Modal(document.getElementById("manageRolesModal"));
        const deleteModal = new bootstrap.Modal(document.getElementById("deleteModal"));
        const roleManagementModal = new bootstrap.Modal(document.getElementById("roleManagementModal"));
        const editRoleModal = new bootstrap.Modal(document.getElementById("editRoleModal"));

        // =====================================================
        // CHECK IF SUPER ADMIN
        // =====================================================

        var isSuperAdmin = @(isSuperAdmin ? "true" : "false");

        // =====================================================
        // CREATE USER MODAL
        // =====================================================

        function openCreateUserModal() {
        $("#createUserForm")[0].reset();
        createModal.show();
        }

        $("#createUserForm").on("submit", function (e) {
        e.preventDefault();

        var password = $("#createPassword").val();
        var confirmPassword = $("#createConfirmPassword").val();

        if (password !== confirmPassword) {
        showToast("error", "Error", "Passwords do not match");
        return;
        }

        var $btn = $("#createBtn");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Creating...');

        $.ajax({
        url: '@Url.Action("Create", "Users")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
        FullName: $("#createFullName").val(),
        Email: $("#createEmail").val(),
        Password: password,
        ConfirmPassword: confirmPassword
        }),
        success: function (response) {
        if (response.success) {
        createModal.hide();
        showToast("success", "Success", response.message);
        setTimeout(function () { location.reload(); }, 1500);
        } else {
        showToast("error", "Error", response.message);
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> Create');
        }
        },
        error: function () {
        showToast("error", "Error", "An error occurred");
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> Create');
        }
        });
        });

        // =====================================================
        // EDIT USER MODAL
        // =====================================================

        function openEditUserModal(id, fullName, email, userName) {
        $("#editUserId").val(id);
        $("#editFullName").val(fullName);
        $("#editEmail").val(email);
        $("#editUserName").val(userName);
        editModal.show();
        }

        $("#editUserForm").on("submit", function (e) {
        e.preventDefault();

        var $btn = $("#editBtn");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Saving...');

        $.ajax({
        url: '@Url.Action("Edit", "Users")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
        Id: $("#editUserId").val(),
        FullName: $("#editFullName").val(),
        Email: $("#editEmail").val(),
        UserName: $("#editUserName").val()
        }),
        success: function (response) {
        if (response.success) {
        editModal.hide();
        showToast("success", "Success", response.message);
        setTimeout(function () { location.reload(); }, 1500);
        } else {
        showToast("error", "Error", response.message);
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> Save');
        }
        },
        error: function () {
        showToast("error", "Error", "An error occurred");
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> Save');
        }
        });
        });

        // =====================================================
        // MANAGE USER ROLES MODAL
        // =====================================================

        function openManageRolesModal(userId, userName) {
        $("#manageRolesUserId").val(userId);
        $("#manageRolesUserName").text("User: " + userName);
        rolesModal.show();

        $("#rolesCheckboxList").html('<div class="text-center py-4"><div class="spinner-border"></div></div>');

        $.ajax({
        url: '@Url.Action("GetUserRoles", "Users")',
        type: 'GET',
        data: { userId: userId },
        success: function (response) {
        if (response.success) {
        var html = '';
        response.roles.forEach(function (role) {
        var checked = role.isAssigned ? 'checked' : '';
        html += '<div class="form-check mb-3">' +
        '<input type="checkbox" class="form-check-input" value="' + role.name + '" id="role_' + role.id + '" ' + checked + '>' +
        '<label class="form-check-label" for="role_' + role.id + '">' + role.name + '</label>' +
        '</div>';
        });
        $("#rolesCheckboxList").html(html);
        }
        },
        error: function () {
        $("#rolesCheckboxList").html('<div class="text-center text-danger">Error loading roles</div>');
        }
        });
        }

        $("#manageRolesForm").on("submit", function (e) {
        e.preventDefault();

        var selectedRoles = [];
        $("#rolesCheckboxList input:checked").each(function () {
        selectedRoles.push($(this).val());
        });

        var $btn = $("#rolesBtn");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Saving...');

        $.ajax({
        url: '@Url.Action("UpdateUserRoles", "Users")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
        UserId: $("#manageRolesUserId").val(),
        UserRoles: selectedRoles
        }),
        success: function (response) {
        if (response.success) {
        rolesModal.hide();
        showToast("success", "Success", response.message);
        setTimeout(function () { location.reload(); }, 1500);
        } else {
        showToast("error", "Error", response.message);
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> Save');
        }
        },
        error: function () {
        showToast("error", "Error", "An error occurred");
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> Save');
        }
        });
        });

        // =====================================================
        // DELETE USER MODAL
        // =====================================================

        $(document).on("click", ".delete-user-btn", function () {
        var userId = $(this).data("user-id");
        var userName = $(this).data("user-name");
        $("#deleteUserId").val(userId);
        $("#userNameToDelete").text(userName);
        deleteModal.show();
        });

        $("#deleteUserForm").on("submit", function (e) {
        e.preventDefault();

        var $btn = $("#confirmDelete");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Deleting...');

        $.ajax({
        url: '@Url.Action("DeleteConfirmed", "Users")',
        type: 'POST',
        data: {
        id: $("#deleteUserId").val(),
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function (response) {
        if (response.success) {
        deleteModal.hide();
        showToast("success", "Success", response.message);
        setTimeout(function () { location.reload(); }, 1500);
        } else {
        showToast("error", "Error", response.message);
        $btn.prop("disabled", false).html('<i class="bi bi-trash3"></i> Delete');
        }
        },
        error: function () {
        showToast("error", "Error", "An error occurred");
        $btn.prop("disabled", false).html('<i class="bi bi-trash3"></i> Delete');
        }
        });
        });

        // =====================================================
        // SEARCH FUNCTIONALITY
        // =====================================================

        $("#userSearch").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#userTable tbody tr").filter(function () {
        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
        });

        // =====================================================
        // TOAST FUNCTION
        // =====================================================

        function showToast(type, title, message) {
        var toastId = 'toast-' + Date.now();
        var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
        var iconClass = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';

        var toastHtml = '<div id="' + toastId + '" class="toast align-items-center border-0 ' + bgClass + ' text-white" role="alert">' +
        '<div class="d-flex">' +
        '<div class="toast-body d-flex align-items-center">' +
        '<i class="bi ' + iconClass + ' me-2"></i>' +
        '<div><strong>' + title + '</strong><div>' + message + '</div></div>' +
        '</div>' +
        '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
        '</div>' +
        '</div>';

        $('.toast-container').append(toastHtml);
        var toastElement = document.getElementById(toastId);
        var toast = new bootstrap.Toast(toastElement, { autohide: true, delay: 5000 });
        toast.show();
        $(toastElement).on('hidden.bs.toast', function () { $(this).remove(); });
        }

        // =====================================================
        // ROLE MANAGEMENT MODAL (For Super Admin)
        // =====================================================

        function openRoleManagementModal() {
        if (!isSuperAdmin) return;
        loadRolesList();
        $("#newRoleName").val("");
        roleManagementModal.show();
        }

        // =====================================================
        // LOAD ROLES LIST (Professional Cards Style)
        // =====================================================

        function loadRolesList() {
        $("#rolesListContainer").html('<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">@Localizer["LoadingRoles"]</p></div>');

        $.ajax({
        url: '@Url.Action("GetAllRoles", "Roles")',
        type: 'GET',
        success: function (response) {
        if (response.success && response.roles.length > 0) {
        var html = '<div class="role-cards-container">';
        response.roles.forEach(function (role) {
        // Get first letter for icon
        var firstLetter = role.name.charAt(0).toUpperCase();
        html += '<div class="role-card">' +
        '<div class="role-name">' +
        '<div class="role-icon">' + firstLetter + '</div>' +
        '<span>' + role.name + '</span>' +
        '</div>' +
        '<div class="role-actions">' +
        '<button type="button" class="role-action-btn role-edit-btn" onclick="openEditRoleModal(\'' + role.id + '\', \'' + role.name.replace(/'/g, "\\'") + '\')" title="@Localizer["EditRole"]">' +
        '<i class="bi bi-pencil-square"></i>' +
        '</button>' +
        '<button type="button" class="role-action-btn role-delete-btn" onclick="deleteRole(\'' + role.id + '\', \'' + role.name.replace(/'/g, "\\'") + '\')" title="@Localizer["DeleteRole"]">' +
        '<i class="bi bi-trash3"></i>' +
        '</button>' +
        '</div>' +
        '</div>';
        });
        html += '</div>';
        $("#rolesListContainer").html(html);
        } else if (response.success && response.roles.length === 0) {
        $("#rolesListContainer").html('<div class="roles-empty-state">' +
        '<i class="bi bi-shield-slash"></i>' +
        '<p>@Localizer["NoRolesFound"]</p>' +
        '</div>');
        } else {
        $("#rolesListContainer").html('<div class="roles-empty-state">' +
        '<i class="bi bi-exclamation-triangle text-danger"></i>' +
        '<p>@Localizer["FailedToLoadRoles"]</p>' +
        '</div>');
        }
        },
        error: function () {
        $("#rolesListContainer").html('<div class="roles-empty-state">' +
        '<i class="bi bi-wifi-off text-danger"></i>' +
        '<p>@Localizer["ErrorLoadingRoles"]</p>' +
        '</div>');
        }
        });
        }
        // =====================================================
        // CREATE ROLE (FIXED)
        // =====================================================

        $("#createRoleBtn").click(function () {
        var roleName = $("#newRoleName").val().trim();

        if (!roleName) {
        Swal.fire({
        icon: 'error',
        title: 'خطأ',
        text: 'الرجاء إدخال اسم الصلاحية',
        confirmButtonText: 'حسنا'
        });
        return;
        }

        var $btn = $(this);
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> جاري الإنشاء...');

        $.ajax({
        url: '@Url.Action("CreateRole", "Roles")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ newRoleName: roleName }),
        success: function (response) {
        if (response.success) {
        Swal.fire({
        icon: 'success',
        title: 'تم بنجاح',
        text: response.message,
        timer: 2000,
        showConfirmButton: false
        });
        $("#newRoleName").val("");
        loadRolesList();
        } else {
        Swal.fire({
        icon: 'error',
        title: 'خطأ',
        text: response.message || 'فشل إنشاء الصلاحية',
        confirmButtonText: 'حسنا'
        });
        }
        },
        error: function (xhr) {
        var errorMsg = xhr.responseJSON?.message || 'حدث خطأ أثناء إنشاء الصلاحية';
        Swal.fire({
        icon: 'error',
        title: 'خطأ',
        text: errorMsg,
        confirmButtonText: 'حسنا'
        });
        },
        complete: function () {
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> <span>@Localizer["Create"]</span>');
        }
        });
        });

        // =====================================================
        // EDIT ROLE (FIXED)
        // =====================================================

        function openEditRoleModal(roleId, roleName) {
        $("#editRoleId").val(roleId);
        $("#editRoleName").val(roleName);
        editRoleModal.show();
        }

        $("#editRoleForm").on("submit", function (e) {
        e.preventDefault();

        var roleId = $("#editRoleId").val();
        var roleName = $("#editRoleName").val().trim();

        if (!roleName) {
        Swal.fire({
        icon: 'error',
        title: 'خطأ',
        text: 'الرجاء إدخال اسم الصلاحية',
        confirmButtonText: 'حسنا'
        });
        return;
        }

        var $btn = $(this).find('button[type="submit"]');
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> جاري الحفظ...');

        $.ajax({
        url: '@Url.Action("EditRole", "Roles")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ id: roleId, name: roleName }),
        success: function (response) {
        if (response.success) {
        editRoleModal.hide();
        Swal.fire({
        icon: 'success',
        title: 'تم بنجاح',
        text: response.message,
        timer: 2000,
        showConfirmButton: false
        });
        loadRolesList();
        } else {
        Swal.fire({
        icon: 'error',
        title: 'خطأ',
        text: response.message || 'فشل تحديث الصلاحية',
        confirmButtonText: 'حسنا'
        });
        }
        },
        error: function () {
        Swal.fire({
        icon: 'error',
        title: 'خطأ',
        text: 'حدث خطأ أثناء تحديث الصلاحية',
        confirmButtonText: 'حسنا'
        });
        },
        complete: function () {
        $btn.prop("disabled", false).html('<i class="bi bi-save"></i> @Localizer["Save"]');
        }
        });
        });

        // =====================================================
        // DELETE ROLE
        // =====================================================

        function deleteRole(roleId, roleName) {
        Swal.fire({
        title: 'Are you sure?',
        html: 'You are about to delete the role: <strong>' + roleName + '</strong><br>This action cannot be undone!',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete it!',
        cancelButtonText: 'Cancel'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("DeleteRole", "Roles")',
        type: 'POST',
        data: { id: roleId },
        success: function (response) {
        if (response.success) {
        Swal.fire('Deleted!', response.message, 'success');
        loadRolesList();
        } else {
        Swal.fire('Error', response.message || 'Failed to delete role', 'error');
        }
        },
        error: function () {
        Swal.fire('Error', 'An error occurred', 'error');
        }
        });
        }
        });
        }
    </script>
}