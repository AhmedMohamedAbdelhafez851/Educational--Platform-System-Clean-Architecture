@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model IEnumerable<OnlineExamSystem.Domains.Entities.ApplicationUser>

@{
    ViewData["Title"] = Localizer["UserManagement"];
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
    var userRoles = ViewBag.UserRoles as Dictionary<string, List<string>>;
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}

@section Styles {
    <link rel="stylesheet" href="~/css/users/index.css" />
}

<div class="users-page">

    <!-- HEADER -->
    <div class="users-page-header">

        <div>
            <h1 class="page-title">
                <i class="bi bi-people-fill"></i>
                @Localizer["UserManagement"]
            </h1>

            <p class="page-subtitle">
                @Localizer["ManageUsersDescription"]
            </p>
        </div>

        <div class="header-buttons">

            <!-- 🔥 MANAGE ROLES BUTTON - ONLY SUPER ADMIN CAN SEE -->
            @if (isSuperAdmin)
            {
                <button type="button"
                        class="btn btn-outline-custom"
                        onclick="openRoleManagementModal()">

                    <i class="bi bi-shield-lock"></i>

                    @Localizer["ManageRoles"]

                </button>
            }

            <!-- CREATE USER BUTTON -->
            <button type="button"
                    class="btn btn-primary-custom"
                    onclick="openCreateUserModal()">

                <i class="bi bi-plus-circle"></i>

                @Localizer["CreateNewUser"]

            </button>

        </div>

    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">

        <div class="col-lg-4 col-md-6">

            <div class="dashboard-card">

                <div>

                    <div class="dashboard-label">
                        @Localizer["TotalUsers"]
                    </div>

                    <h3>@Model.Count()</h3>

                </div>

                <div class="dashboard-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

            </div>

        </div>

        <div class="col-lg-4 col-md-6">

            <div class="dashboard-card">

                <div>

                    <div class="dashboard-label">
                        @Localizer["Admins"]
                    </div>

                    <h3>
                        @Model.Count(u =>
                        userRoles != null &&
                        userRoles.ContainsKey(u.Id) &&
                        userRoles[u.Id].Contains("Admin"))
                    </h3>

                </div>

                <div class="dashboard-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

            </div>

        </div>

        <div class="col-lg-4 col-md-6">

            <div class="dashboard-card">

                <div>

                    <div class="dashboard-label">
                        @Localizer["Students"]
                    </div>

                    <h3>
                        @Model.Count(u =>
                        userRoles != null &&
                        userRoles.ContainsKey(u.Id) &&
                        userRoles[u.Id].Contains("Student"))
                    </h3>

                </div>

                <div class="dashboard-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

            </div>

        </div>

    </div>

    <!-- TABLE -->
    <div class="modern-table-wrapper">

        <!-- TOOLBAR -->
        <div class="table-toolbar">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="userSearch"
                       placeholder="@Localizer["SearchUsers"]" />

            </div>

        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h4>@Localizer["NoUsersFound"]</h4>

                <p>@Localizer["NoUsersMessage"]</p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table modern-table align-middle"
                       id="userTable">

                    <thead>

                        <tr>

                            <th>@Localizer["FullName"]</th>

                            <th>@Localizer["Email"]</th>

                            <th>@Localizer["Roles"]</th>

                            <th class="text-center">
                                @Localizer["Actions"]
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr id="user-@user.Id">

                                <!-- USER -->
                                <td>

                                    <div class="user-info">

                                        <div class="user-avatar">
                                            @(user.FullName?.Substring(0, 1).ToUpper())
                                        </div>

                                        <div>

                                            <div class="user-name">
                                                @user.FullName
                                            </div>

                                            <div class="user-username">
                                                @@@user.UserName
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- EMAIL -->
                                <td>
                                    @user.Email
                                </td>

                                <!-- ROLES -->
                                <td>

                                    @if (userRoles != null &&
                                   userRoles.ContainsKey(user.Id))
                                    {
                                        <div class="roles-wrapper">

                                            @foreach (var role in userRoles[user.Id])
                                            {
                                                var roleClass =
                                                role == "Admin"
                                                ? "admin-role"
                                                : "student-role";

                                                <span class="role-badge @roleClass">
                                                    @role
                                                </span>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-role">
                                            @Localizer["NoRolesAssigned"]
                                        </span>
                                    }

                                </td>

                                <!-- ACTIONS -->
                                <td>

                                    <div class="table-actions">

                                        <!-- ROLES -->
                                        <button type="button"
                                                class="action-btn role-btn"
                                                onclick="openManageRolesModal('@user.Id','@user.FullName')">

                                            <i class="bi bi-person-gear"></i>

                                        </button>

                                        <!-- EDIT -->
                                        <button type="button"
                                                class="action-btn edit-btn"
                                                onclick="openEditUserModal('@user.Id','@user.FullName','@user.Email','@user.UserName')">

                                            <i class="bi bi-pencil-square"></i>

                                        </button>

                                        <!-- DELETE -->
                                        <button type="button"
                                                class="action-btn delete-btn delete-user-btn"
                                                data-user-id="@user.Id"
                                                data-user-name="@user.FullName">

                                            <i class="bi bi-trash3"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<!-- ===================================================== -->
<!-- ROLE MANAGEMENT MODAL (Professional Version) -->
<!-- ===================================================== -->

<div class="modal fade role-management-modal"
     id="roleManagementModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content custom-modal">

            <div class="modal-header custom-modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-shield-lock"></i>

                    @Localizer["RoleManagement"]

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body" style="padding: 1.5rem;">

                <!-- CREATE ROLE SECTION -->
                <div class="role-create-section">

                    <div class="role-create-title">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>@Localizer["CreateNewRole"]</span>
                    </div>

                    <div class="input-group-custom">
                        <input type="text"
                               class="form-control"
                               id="newRoleName"
                               placeholder="@Localizer["EnterRoleName"]" />

                        <button type="button"
                                class="btn-create-role"
                                id="createRoleBtn">

                            <i class="bi bi-save"></i>
                            <span>@Localizer["Create"]</span>

                        </button>
                    </div>

                </div>

                <!-- EXISTING ROLES SECTION -->
                <div class="roles-section-header">
                    <i class="bi bi-list-ul"></i>
                    <h6>@Localizer["ExistingRoles"]</h6>
                </div>

                <div class="role-management-container">
                    <div id="rolesListContainer">
                        <!-- Roles will be loaded here -->
                    </div>
                </div>

            </div>

            <div class="modal-footer custom-modal-footer">

                <button type="button"
                        class="btn btn-light-custom"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-lg me-1"></i>
                    @Localizer["Close"]

                </button>

            </div>

        </div>

    </div>

</div>
<!-- ===================================================== -->
<!-- EDIT ROLE MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="editRoleModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content custom-modal">

            <div class="modal-header custom-modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-pencil-square"></i>

                    @Localizer["EditRole"]

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="editRoleForm">

                <input type="hidden" id="editRoleId" />

                <div class="modal-body">

                    <div class="form-floating mb-3">

                        <input type="text"
                               class="form-control custom-input"
                               id="editRoleName"
                               required>

                        <label>@Localizer["RoleName"]</label>

                    </div>

                </div>

                <div class="modal-footer custom-modal-footer">

                    <button type="button"
                            class="btn btn-light-custom"
                            data-bs-dismiss="modal">

                        @Localizer["Cancel"]

                    </button>

                    <button type="submit"
                            class="btn btn-primary-custom">

                        <i class="bi bi-save"></i>

                        @Localizer["Save"]

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- CREATE USER MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="createUserModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content custom-modal">

            <div class="modal-header custom-modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-person-plus-fill"></i>

                    @Localizer["CreateNewUser"]

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="createUserForm">

                <div class="modal-body">

                    <div class="form-floating mb-3">

                        <input type="text"
                               class="form-control custom-input"
                               id="createFullName"
                               name="FullName"
                               required>

                        <label>@Localizer["FullName"]</label>

                    </div>

                    <div class="form-floating mb-3">

                        <input type="email"
                               class="form-control custom-input"
                               id="createEmail"
                               name="Email"
                               required>

                        <label>@Localizer["Email"]</label>

                    </div>

                    <div class="form-floating mb-3">

                        <input type="password"
                               class="form-control custom-input"
                               id="createPassword"
                               name="Password"
                               required>

                        <label>@Localizer["Password"]</label>

                    </div>

                    <div class="form-floating">

                        <input type="password"
                               class="form-control custom-input"
                               id="createConfirmPassword"
                               name="ConfirmPassword"
                               required>

                        <label>@Localizer["ConfirmPassword"]</label>

                    </div>

                </div>

                <div class="modal-footer custom-modal-footer">

                    <button type="button"
                            class="btn btn-light-custom"
                            data-bs-dismiss="modal">

                        @Localizer["Cancel"]

                    </button>

                    <button type="submit"
                            class="btn btn-primary-custom"
                            id="createBtn">

                        <i class="bi bi-save"></i>

                        @Localizer["Create"]

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- EDIT USER MODAL -->
