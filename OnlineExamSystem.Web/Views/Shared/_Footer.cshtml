@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<footer>
    <div class="container text-center">
        <div class="footer-links mb-3">
            <a href="#" class="text-decoration-none text-white">
                <i class="bi bi-info-circle me-1"></i>
                <span class="d-none d-md-inline">@Localizer["AboutUs"]</span>
            </a>
            <a href="#" class="text-decoration-none text-white">
                <i class="bi bi-envelope me-1"></i>
                <span class="d-none d-md-inline">@Localizer["Contact"]</span>
            </a>
            <a href="#" class="text-decoration-none text-white">
                <i class="bi bi-shield-lock me-1"></i>
                <span class="d-none d-md-inline">@Localizer["PrivacyPolicy"]</span>
            </a>
            <a href="#" class="text-decoration-none text-white">
                <i class="bi bi-file-text me-1"></i>
                <span class="d-none d-md-inline">@Localizer["TermsOfService"]</span>
            </a>
        </div>
        <div class="social-icons mb-3">
            <a href="#" class="text-white me-3" aria-label="Facebook">
                <i class="bi bi-facebook"></i>
            </a>
            <a href="#" class="text-white me-3" aria-label="Twitter">
                <i class="bi bi-twitter-x"></i>
            </a>
            <a href="#" class="text-white me-3" aria-label="LinkedIn">
                <i class="bi bi-linkedin"></i>
            </a>
            <a href="#" class="text-white" aria-label="GitHub">
                <i class="bi bi-github"></i>
            </a>
        </div>
        <p class="mb-0 text-white">
            <i class="bi bi-c-circle me-1"></i>
            &copy; @DateTime.Now.Year - @Localizer["AppTitle"]. @Localizer["AllRightsReserved"]
        </p>
        <small class="text-white-50 mt-2 d-block">@Localizer["Version"] 2.0</small>
    </div>
</footer>
<style>
/* =========================================
FOOTER
========================================= */

footer {
background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
padding: 1rem 0;
margin-top: auto;
}

.footer-links {
display: flex;
justify-content: center;
align-items: center;
gap: 1rem;
flex-wrap: wrap;
margin-bottom: 0.75rem !important;
}

.footer-links a {
transition: all 0.2s ease;
font-size: 0.8rem;
opacity: 0.95;
}

.footer-links a:hover {
opacity: 0.85;
transform: translateY(-1px);
}

.social-icons {
margin-bottom: 0.75rem !important;
}

.social-icons a {
font-size: 0.9rem;
transition: all 0.2s ease;
display: inline-block;
}

.social-icons a:hover {
transform: translateY(-2px);
opacity: 0.85;
}

footer p {
font-size: 0.8rem;
margin-bottom: 0.25rem !important;
}

footer small {
font-size: 0.7rem;
}


/* =========================================
MOBILE FOOTER
========================================= */

@@media (max-width: 768px) {

footer {
padding: 0.85rem 0;
}

.footer-links {
gap: 0.75rem;
margin-bottom: 0.5rem !important;
}

.footer-links a {
font-size: 0.72rem;
}

.social-icons {
margin-bottom: 0.5rem !important;
}

.social-icons a {
font-size: 0.82rem;
}

footer p {
font-size: 0.72rem;
}

footer small {
font-size: 0.65rem;
}
}
</style>