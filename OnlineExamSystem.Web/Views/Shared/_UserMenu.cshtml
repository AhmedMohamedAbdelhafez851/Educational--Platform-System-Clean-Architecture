@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Identity
@using OnlineExamSystem.Domains.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");
    var isTeacher = User.IsInRole("Teacher");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="nav-links">
    <!-- Dashboard - SuperAdmin and Admin can see -->
    @if (isSuperAdmin || isAdmin)
    {
        <a asp-controller="Dashboard" asp-action="Index"
           class="nav-link @(currentController == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2 me-1"></i>
            <span>@Localizer["Dashboard"]</span>
        </a>
    }

    <!-- Exams - SuperAdmin, Admin, and Teacher can see -->
    @if (isSuperAdmin || isAdmin || isTeacher)
    {
        <a asp-controller="Exam" asp-action="Index"
           class="nav-link @((currentController == "Exam" || currentController == "Question") ? "active" : "")">
            <i class="bi bi-journal-bookmark-fill me-1"></i>
            <span>@Localizer["Exams"]</span>
        </a>
    }

    <!-- Analytics - SuperAdmin, Admin, and Teacher can see -->
    @if (isSuperAdmin || isAdmin || isTeacher)
    {
        <a asp-controller="Analytics" asp-action="Overview"
           class="nav-link @(currentController == "Analytics" ? "active" : "")">
            <i class="bi bi-graph-up me-1"></i>
            <span>@Localizer["Analytics"]</span>
        </a>
    }

    <!-- Users Management - ONLY SuperAdmin can see -->
    @if (isSuperAdmin)
    {
        <a asp-controller="Users" asp-action="Index"
           class="nav-link @((currentController == "Users" || currentController == "Roles") ? "active" : "")">
            <i class="bi bi-people me-1"></i>
            <span>@Localizer["Users"]</span>
        </a>
    }

    <!-- Student view - Only for Students -->
    @if (!isSuperAdmin && !isAdmin && !isTeacher)
    {
        <a asp-controller="UserExam" asp-action="Index"
           class="nav-link @(currentController == "UserExam" ? "active" : "")">
            <i class="bi bi-pencil-square me-1"></i>
            <span>@Localizer["MyExams"]</span>
        </a>
    }
</div>

<!-- User Dropdown Menu - Fixed Bootstrap Dropdown -->
<div class="user-menu dropdown">
    <button class="btn btn-link dropdown-toggle user-dropdown-btn"
            type="button"
            id="userDropdownMenuButton"
            data-bs-toggle="dropdown"
            data-bs-auto-close="outside"
            aria-expanded="false">
        <div class="user-avatar">
            <i class="bi bi-person-fill"></i>
        </div>
        <div class="user-info">
            <div class="user-name">@(User.Identity?.Name ?? "User")</div>
            <div class="user-role">
                @if (isSuperAdmin)
                {
                    <span>Super Admin</span>
                }
                else if (isAdmin)
                {
                    <span>Admin</span>
                }
                else if (isTeacher)
                {
                    <span>Teacher</span>
                }
                else
                {
                    <span>Student</span>
                }
            </div>
        </div>
        <i class="bi bi-chevron-down dropdown-arrow"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdownMenuButton">
        <li>
            <a class="dropdown-item" asp-controller="UserExam" asp-action="Index">
                <i class="bi bi-pencil-square me-2"></i>@Localizer["MyExams"]
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right me-2"></i>@Localizer["Logout"]
            </a>
        </li>
    </ul>
</div>

<style>
    /* User Dropdown Button Styles */
    .user-dropdown-btn {
        display: flex !important;
        align-items: center !important;
        gap: 0.5rem !important;
        padding: 0.25rem 0.5rem !important;
        border-radius: 40px !important;
        text-decoration: none !important;
        color: white !important;
        transition: all 0.2s ease !important;
        background: none !important;
        border: none !important;
    }

        .user-dropdown-btn:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            color: white !important;
        }

        .user-dropdown-btn:focus {
            box-shadow: none !important;
            outline: none !important;
        }

        .user-dropdown-btn.show {
            background: rgba(255, 255, 255, 0.15) !important;
        }

    /* Dropdown arrow animation */
    .dropdown-arrow {
        transition: transform 0.2s ease;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .user-dropdown-btn[aria-expanded="true"] .dropdown-arrow {
        transform: rotate(180deg);
    }

    /* Dropdown menu styles */
    .dropdown-menu {
        animation: dropdownFade 0.2s ease;
        border: none;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        border-radius: 16px;
        padding: 0.5rem;
        min-width: 200px;
        z-index: 1050;
    }

    @@keyframes dropdownFade {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .dropdown-item {
        padding: 0.5rem 1rem;
        border-radius: 12px;
        font-size: 0.875rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .dropdown-item:hover {
            background-color: #f1f5f9;
        }

        .dropdown-item i {
            width: 1.25rem;
        }

    .dropdown-divider {
        margin: 0.25rem 0;
    }

    /* Mobile Styles */
    @@media (max-width: 991px) {
        .user-dropdown-btn {
            width: 100%;
            justify-content: space-between;
            padding: 0.75rem !important;
        }

        .user-info {
            flex: 1;
            text-align: left;
        }

        .dropdown-menu {
            position: static !important;
            width: 100%;
            margin-top: 0.5rem;
            transform: none !important;
            box-shadow: none;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.95);
        }
    }

    /* RTL Support */
    body[dir="rtl"] .user-info {
        text-align: right;
    }

    @@media (max-width: 991px) {
        body[dir="rtl"] .user-info {
            text-align: right;
        }
    }
</style>