@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Identity
@using OnlineExamSystem.Domains.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");
    var isTeacher = User.IsInRole("Teacher");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="nav-links">
    <!-- Dashboard - SuperAdmin and Admin can see -->
    @if (isSuperAdmin || isAdmin)
    {
        <a asp-controller="Dashboard" asp-action="Index"
           class="nav-link @(currentController == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2 me-1"></i>
            <span>@Localizer["Dashboard"]</span>
        </a>
    }

    <!-- Exams - SuperAdmin, Admin, and Teacher can see -->
    @if (isSuperAdmin || isAdmin || isTeacher)
    {
        <a asp-controller="Exam" asp-action="Index"
           class="nav-link @((currentController == "Exam" || currentController == "Question") ? "active" : "")">
            <i class="bi bi-journal-bookmark-fill me-1"></i>
            <span>@Localizer["Exams"]</span>
        </a>
    }

    <!-- Analytics - SuperAdmin, Admin, and Teacher can see -->
    @if (isSuperAdmin || isAdmin || isTeacher)
    {
        <a asp-controller="Analytics" asp-action="Overview"
           class="nav-link @(currentController == "Analytics" ? "active" : "")">
            <i class="bi bi-graph-up me-1"></i>
            <span>@Localizer["Analytics"]</span>
        </a>
    }

    <!-- Users Management - ONLY SuperAdmin can see -->
    @if (isSuperAdmin)
    {
        <a asp-controller="Users" asp-action="Index"
           class="nav-link @((currentController == "Users" || currentController == "Roles") ? "active" : "")">
            <i class="bi bi-people me-1"></i>
            <span>@Localizer["Users"]</span>
        </a>
    }

    <!-- Student view - Only for Students -->
    @if (!isSuperAdmin && !isAdmin && !isTeacher)
    {
        <a asp-controller="UserExam" asp-action="Index"
           class="nav-link @(currentController == "UserExam" ? "active" : "")">
            <i class="bi bi-pencil-square me-1"></i>
            <span>@Localizer["MyExams"]</span>
        </a>
    }
</div>

<!-- User Dropdown Menu -->
<div class="user-menu dropdown">
    <button class="dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <div class="user-avatar">
            <i class="bi bi-person-fill"></i>
        </div>
        <div class="user-info">
            <div class="user-name">@(User.Identity?.Name ?? "User")</div>
            <div class="user-role">
                @if (isSuperAdmin)
                {
                    <span>Super Admin</span>
                }
                else if (isAdmin)
                {
                    <span>Admin</span>
                }
                else if (isTeacher)
                {
                    <span>Teacher</span>
                }
                else
                {
                    <span>Student</span>
                }
            </div>
        </div>
        <i class="bi bi-chevron-down dropdown-arrow"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
        <li>
            <a class="dropdown-item" asp-controller="UserExam" asp-action="Index">
                <i class="bi bi-pencil-square me-2"></i>@Localizer["MyExams"]
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right me-2"></i>@Localizer["Logout"]
            </a>
        </li>
    </ul>
</div>

<style>
    /* Navigation Links Container */
    .nav-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-right: 1rem;
    }

    /* Dropdown arrow animation */
    .dropdown-arrow {
        transition: transform 0.2s ease;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.7);
    }

    .dropdown-toggle[aria-expanded="true"] .dropdown-arrow {
        transform: rotate(180deg);
    }

    /* Mobile Styles */
    @@media (max-width: 991px) {
        .nav-links {
            flex-direction: column;
            width: 100%;
            margin-right: 0;
            margin-bottom: 1rem;
            gap: 0.5rem;
        }

        .nav-link {
            width: 100%;
            text-align: center;
            justify-content: center;
        }

            .nav-link i {
                margin-right: 0.5rem;
            }

        .user-menu {
            width: 100%;
        }

            .user-menu .dropdown-toggle {
                width: 100%;
                justify-content: space-between;
                padding: 0.75rem;
            }

        .user-info {
            flex: 1;
            text-align: left;
        }

        .dropdown-menu {
            position: static !important;
            width: 100%;
            margin-top: 0.5rem;
            transform: none !important;
            box-shadow: none;
            background: rgba(255,255,255,0.95);
            border: 1px solid rgba(0,0,0,0.1);
        }
    }

    /* RTL Support */
    body[dir="rtl"] .user-info {
        text-align: right;
    }

    body[dir="rtl"] .nav-links {
        margin-right: 0;
        margin-left: 1rem;
    }

    @@media (max-width: 991px) {
        body[dir="rtl"] .nav-links {
            margin-left: 0;
        }

        body[dir="rtl"] .user-info {
            text-align: right;
        }
    }
</style>