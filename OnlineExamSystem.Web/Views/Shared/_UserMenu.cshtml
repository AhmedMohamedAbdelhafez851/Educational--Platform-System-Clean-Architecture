@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Identity
@using OnlineExamSystem.Domains.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");
    var isTeacher = User.IsInRole("Teacher");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="nav-links d-none d-lg-flex align-items-center gap-2">
    <!-- Dashboard - Everyone can see -->
    <a asp-controller="Dashboard" asp-action="Index"
       class="nav-link @(currentController == "Dashboard" ? "active" : "")">
        <i class="bi bi-speedometer2 me-1"></i>
        <span>@Localizer["Dashboard"]</span>
    </a>

    <!-- Exams - Teachers and Admins can see -->
    @if (isAdmin || isTeacher)
    {
        <a asp-controller="Exam" asp-action="Index"
           class="nav-link @((currentController == "Exam" || currentController == "Question") ? "active" : "")">
            <i class="bi bi-journal-bookmark-fill me-1"></i>
            <span>@Localizer["Exams"]</span>
        </a>
    }

    <!-- Analytics - Teachers and Admins can see -->
    @if (isAdmin || isTeacher)
    {
        <a asp-controller="Analytics" asp-action="Overview"
           class="nav-link @(currentController == "Analytics" ? "active" : "")">
            <i class="bi bi-graph-up me-1"></i>
            <span>@Localizer["Analytics"]</span>
        </a>
    }

    <!-- Users Management - ONLY SuperAdmin can see -->
    @if (isSuperAdmin)
    {
        <a asp-controller="Users" asp-action="Index"
           class="nav-link @((currentController == "Users" || currentController == "Roles") ? "active" : "")">
            <i class="bi bi-people me-1"></i>
            <span>@Localizer["Users"]</span>
        </a>
    }

    <!-- Students view (if not admin/teacher) -->
    @if (!isAdmin && !isTeacher)
    {
        <a asp-controller="UserExam" asp-action="Index"
           class="nav-link @(currentController == "UserExam" ? "active" : "")">
            <i class="bi bi-pencil-square me-1"></i>
            <span>@Localizer["MyExams"]</span>
        </a>
    }
</div>

<!-- User Menu -->
<div class="user-menu dropdown">
    <a class="dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button"
       data-bs-toggle="dropdown" aria-expanded="false">
        <div class="user-avatar">
            <i class="bi bi-person-fill"></i>
        </div>
        <div class="user-info d-none d-md-block">
            <div class="user-name">@(User.Identity?.Name ?? "User")</div>
            <div class="user-role">
                @if (isSuperAdmin)
                {
                    <span>Super Administrator</span>
                }
                else if (isAdmin)
                {
                    <span>Administrator</span>
                }
                else if (isTeacher)
                {
                    <span>Teacher</span>
                }
                else
                {
                    <span>Student</span>
                }
            </div>
        </div>
    </a>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
        <li>
            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                <i class="bi bi-person me-2"></i>@Localizer["MyProfile"]
            </a>
        </li>
        <li>
            <a class="dropdown-item" asp-controller="UserExam" asp-action="Index">
                <i class="bi bi-pencil-square me-2"></i>@Localizer["MyExams"]
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right me-2"></i>@Localizer["Logout"]
            </a>
        </li>
    </ul>
</div>

<style>
    .nav-links {
        margin-right: 1rem;
    }

    .nav-link {
        padding: 0.5rem 1rem;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.2s ease;
        color: rgba(255, 255, 255, 0.8);
        position: relative;
    }

        .nav-link:hover {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }

        .nav-link.active {
            color: white;
            background: rgba(255, 255, 255, 0.15);
        }

            .nav-link.active::after {
                content: '';
                position: absolute;
                bottom: -2px;
                left: 50%;
                transform: translateX(-50%);
                width: 30px;
                height: 2px;
                background: white;
                border-radius: 2px;
            }

    body[dir="rtl"] .nav-links {
        margin-right: 0;
        margin-left: 1rem;
    }

    .user-menu {
        position: relative;
    }

        .user-menu .dropdown-toggle {
            text-decoration: none;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 40px;
            transition: all 0.2s ease;
        }

            .user-menu .dropdown-toggle:hover {
                background: rgba(255, 255, 255, 0.1);
            }

    .user-avatar {
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .user-info {
        text-align: left;
    }

    body[dir="rtl"] .user-info {
        text-align: right;
    }

    .user-name {
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.2;
    }

    .user-role {
        font-size: 0.625rem;
        opacity: 0.7;
        line-height: 1.2;
    }

    .dropdown-item {
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        transition: all 0.2s ease;
    }

        .dropdown-item:hover {
            background-color: #f3f4f6;
        }

        .dropdown-item i {
            width: 1.25rem;
        }

    @@media (max-width: 991px) {
        .nav-links {
            flex-direction: column;
            width: 100%;
            margin-right: 0;
            margin-bottom: 1rem;
        }

        .nav-link {
            width: 100%;
        }

            .nav-link.active::after {
                display: none;
            }
    }
</style>