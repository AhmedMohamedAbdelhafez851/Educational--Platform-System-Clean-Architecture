@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<OnlineExamSystem.Application.DTOs.Exam.ExamListDto>

@{
    ViewData["Title"] = "إدارة الامتحانات";
    var isRtl = true;
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/css/pages/exam-management.css" rel="stylesheet" />
}

<div class="exam-management">
    <!-- Header -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon">
                <i class="bi bi-journal-bookmark-fill"></i>
            </div>
            <div class="header-text">
                <h1 class="page-title">إدارة الامتحانات</h1>
                <p class="page-description">إنشاء وإدارة الامتحانات ومتابعة أداء الطلاب</p>
            </div>
        </div>
        <button type="button" class="btn-create-exam" id="openCreateModalBtn">
            <i class="bi bi-plus-circle"></i>
            <span>امتحان جديد</span>
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon purple-bg">
                <i class="bi bi-journal-check"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@Model.Count()</span>
                <span class="stat-label">إجمالي الامتحانات</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue-bg">
                <i class="bi bi-question-circle"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@Model.Sum(e => e.QuestionsCount)</span>
                <span class="stat-label">إجمالي الأسئلة</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green-bg">
                <i class="bi bi-people"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@Model.Count(e => e.QuestionsCount > 0)</span>
                <span class="stat-label">امتحانات نشطة</span>
            </div>
        </div>
    </div>

    <!-- Exams Table -->
    <div class="table-container">
        <div class="table-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="searchExams" placeholder="بحث في الامتحانات..." class="search-input">
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-journal-x"></i>
                </div>
                <h3>لا توجد امتحانات بعد</h3>
                <p>ابدأ بإضافة أول امتحان لك</p>
                <button type="button" class="btn-create-exam empty-state-btn" id="openCreateModalBtnEmpty">
                    <i class="bi bi-plus-circle"></i>
                    إضافة أول امتحان
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="exams-table" id="examsTable">
                    <thead>
                        <tr>
                            <th>عنوان الامتحان</th>
                            <th>المدة</th>
                            <th>الأسئلة</th>
                            <th class="actions-column">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model)
                        {
                            <tr id="exam-row-@exam.ExamId" class="exam-row">
                                <td class="exam-title-cell">
                                    <div class="exam-info">
                                        <div class="exam-icon">
                                            <i class="bi bi-journal-check"></i>
                                        </div>
                                        <div class="exam-details">
                                            <span class="exam-name">@exam.Title</span>
                                            <div class="exam-meta">
                                                <span class="meta-item">
                                                    <i class="bi bi-star-fill"></i>
                                                    @exam.TotalDegree نقطة
                                                </span>
                                                <span class="meta-item">
                                                    <i class="bi bi-clock-history"></i>
                                                    @exam.DurationInMinutes دقيقة
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                 </td>
                                <td class="exam-duration-cell">
                                    <div class="duration-badge">
                                        <i class="bi bi-hourglass-split"></i>
                                        <span>@exam.DurationInMinutes د</span>
                                    </div>
                                 </td>
                                <td class="exam-questions-cell">
                                    <div class="questions-count">
                                        <i class="bi bi-question-circle"></i>
                                        <span>@exam.QuestionsCount</span>
                                    </div>
                                 </td>
                                <td class="actions-cell">
                                    <div class="actions-dropdown">
                                        <button class="dropdown-trigger" data-exam-id="@exam.ExamId" aria-label="إجراءات">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <div class="dropdown-menu-custom" id="dropdown-@exam.ExamId" data-exam-id="@exam.ExamId">
                                            <a asp-controller="Question" asp-action="Index" asp-route-examId="@exam.ExamId" class="dropdown-item">
                                                <i class="bi bi-list-check"></i>
                                                <span>إدارة الأسئلة</span>
                                            </a>
                                            <a asp-action="Invitations" asp-route-examId="@exam.ExamId" class="dropdown-item">
                                                <i class="bi bi-link-45deg"></i>
                                                <span>روابط الدعوة</span>
                                            </a>
                                            <a asp-controller="Analytics" asp-action="ExamReport" asp-route-examId="@exam.ExamId" class="dropdown-item">
                                                <i class="bi bi-graph-up"></i>
                                                <span>عرض التحليلات</span>
                                            </a>
                                            <div class="dropdown-divider"></div>
                                            <button type="button" class="dropdown-item edit-exam-btn" 
                                                    data-id="@exam.ExamId" 
                                                    data-title="@exam.Title" 
                                                    data-time="@exam.DurationInMinutes" 
                                                    data-degree="@exam.TotalDegree">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>تعديل الامتحان</span>
                                            </button>
                                            <button type="button" class="dropdown-item delete-exam-btn text-danger" 
                                                    data-id="@exam.ExamId" 
                                                    data-title="@exam.Title">
                                                <i class="bi bi-trash3"></i>
                                                <span>حذف الامتحان</span>
                                            </button>
                                        </div>
                                    </div>
                                 </td>
                             </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <div class="modal-header-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <h5 class="modal-title">امتحان جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <form id="createExamForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="examTitle" class="form-label">عنوان الامتحان</label>
                        <input type="text" class="form-control" id="examTitle" name="Title" 
                               placeholder="أدخل عنوان الامتحان" required autocomplete="off">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="examTime" class="form-label">المدة (دقائق)</label>
                            <input type="number" class="form-control" id="examTime" name="DurationInMinutes" 
                                   placeholder="60" min="1" value="60" required>
                        </div>
                        <div class="form-group">
                            <label for="examDegree" class="form-label">الدرجة الكلية</label>
                            <input type="number" class="form-control" id="examDegree" name="TotalDegree" 
                                   placeholder="100" min="1" value="100" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn-primary">إنشاء الامتحان</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <div class="modal-header-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <h5 class="modal-title">تعديل الامتحان</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <form id="editExamForm">
                <input type="hidden" id="editExamId" name="Id">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="editExamTitle" class="form-label">عنوان الامتحان</label>
                        <input type="text" class="form-control" id="editExamTitle" name="Title" required autocomplete="off">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="editExamTime" class="form-label">المدة (دقائق)</label>
                            <input type="number" class="form-control" id="editExamTime" name="DurationInMinutes" min="1" required>
                        </div>
                        <div class="form-group">
                            <label for="editExamDegree" class="form-label">الدرجة الكلية</label>
                            <input type="number" class="form-control" id="editExamDegree" name="TotalDegree" min="1" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn-primary">حفظ التغييرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal modal-danger">
            <div class="modal-header">
                <div class="modal-header-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h5 class="modal-title">حذف الامتحان</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="delete-warning">
                    <i class="bi bi-trash3-fill"></i>
                    <p>هل أنت متأكد من حذف الامتحان <strong id="deleteExamTitle"></strong>؟</p>
                    <div class="warning-note">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>هذا الإجراء لا يمكن التراجع عنه. سيتم حذف جميع الأسئلة المرتبطة بهذا الامتحان.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn-danger" id="confirmDeleteExam">حذف الامتحان</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            var activeDropdown = null;
            var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

            // تهيئة جدول البيانات
            var table = $('#examsTable').DataTable({
                responsive: true,
                pageLength: isMobile ? 5 : 10,
                language: {
                    sProcessing: "جارٍ التحميل...",
                    sLengthMenu: "أظهر _MENU_ مدخلات",
                    sZeroRecords: "لم يتم العثور على نتائج",
                    sInfo: "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                    sInfoEmpty: "يعرض 0 إلى 0 من أصل 0 سجل",
                    sInfoFiltered: "(تمت التصفية من مجموع _MAX_ مدخل)",
                    sSearch: "ابحث:",
                    oPaginate: {
                        sFirst: "الأول",
                        sPrevious: "السابق",
                        sNext: "التالي",
                        sLast: "الأخير"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });

            // البحث المخصص
            $('#searchExams').on('keyup', function() {
                table.search($(this).val()).draw();
            });

            // =====================================================
            // معالج القائمة المنسدلة - متوافق مع الموبايل
            // =====================================================
            
            // فتح القائمة عند النقر على زر الثلاث نقاط
            $(document).on('click', '.dropdown-trigger', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                var examId = $(this).data('exam-id');
                var dropdown = $('#dropdown-' + examId);
                var triggerButton = $(this);
                
                // إغلاق جميع القوائم الأخرى
                $('.dropdown-menu-custom.show').not(dropdown).removeClass('show');
                
                // تبديل القائمة الحالية
                if (dropdown.hasClass('show')) {
                    dropdown.removeClass('show');
                    activeDropdown = null;
                } else {
                    // تحديد موقع القائمة بناءً على نوع الجهاز
                    if (isMobile) {
                        // على الموبايل: نضع القائمة في منتصف الشاشة تقريباً
                        var buttonOffset = triggerButton.offset();
                        var windowHeight = $(window).height();
                        var dropdownHeight = 280; // ارتفاع تقريبي للقائمة
                        var topPosition = buttonOffset.top - 20;
                        
                        if (topPosition + dropdownHeight > windowHeight) {
                            topPosition = windowHeight - dropdownHeight - 10;
                        }
                        
                        dropdown.css({
                            'position': 'fixed',
                            'top': topPosition + 'px',
                            'right': '10px',
                            'left': 'auto',
                            'min-width': '200px',
                            'z-index': 9999
                        });
                    } else {
                        // على سطح المكتب: نضع القائمة بجوار الزر
                        dropdown.css({
                            'position': 'absolute',
                            'top': '100%',
                            'right': '0',
                            'left': 'auto'
                        });
                    }
                    
                    dropdown.addClass('show');
                    activeDropdown = dropdown;
                }
            });
            
            // إغلاق القائمة عند النقر خارجها
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.actions-dropdown').length) {
                    $('.dropdown-menu-custom.show').removeClass('show');
                    $('.dropdown-menu-custom').css('position', '');
                    activeDropdown = null;
                }
            });
            
            // إغلاق القائمة عند الضغط على زر الإلغاء
            $(document).on('click', '.dropdown-item', function() {
                $('.dropdown-menu-custom.show').removeClass('show');
                $('.dropdown-menu-custom').css('position', '');
                activeDropdown = null;
            });
            
            // إغلاق القائمة عند الضغط على Escape
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && activeDropdown) {
                    activeDropdown.removeClass('show');
                    activeDropdown.css('position', '');
                    activeDropdown = null;
                }
            });

            // =====================================================
            // نافذة إنشاء امتحان جديد
            // =====================================================
            $('#openCreateModalBtn, #openCreateModalBtnEmpty').on('click', function() {
                $('#createExamForm')[0].reset();
                $('#createExamModal').modal('show');
            });

            $("#createExamForm").submit(function(e) {
                e.preventDefault();
                var $form = $(this);
                var $submitBtn = $form.find('.btn-primary');
                
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> جاري الإنشاء...');

                $.ajax({
                    url: '@Url.Action("Create", "Exam")',
                    type: 'POST',
                    data: $form.serialize(),
                    success: function() {
                        $('#createExamModal').modal('hide');
                        location.reload();
                    },
                    error: function(xhr) {
                        alert(xhr.responseText);
                        $submitBtn.prop('disabled', false).html('إنشاء الامتحان');
                    }
                });
            });

            // =====================================================
            // تعديل الامتحان
            // =====================================================
            $(document).on("click", ".edit-exam-btn", function() {
                $("#editExamId").val($(this).data("id"));
                $("#editExamTitle").val($(this).data("title"));
                $("#editExamTime").val($(this).data("time"));
                $("#editExamDegree").val($(this).data("degree"));
                $("#editExamModal").modal("show");
                $('.dropdown-menu-custom.show').removeClass('show');
                $('.dropdown-menu-custom').css('position', '');
            });

            $("#editExamForm").submit(function(e) {
                e.preventDefault();
                var examId = $("#editExamId").val();
                var $form = $(this);
                var $submitBtn = $form.find('.btn-primary');
                
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> جاري الحفظ...');

                $.ajax({
                    url: '@Url.Action("Edit", "Exam")/' + examId,
                    type: 'POST',
                    data: $form.serialize(),
                    success: function() {
                        $('#editExamModal').modal('hide');
                        location.reload();
                    },
                    error: function(xhr) {
                        alert(xhr.responseText);
                        $submitBtn.prop('disabled', false).html('حفظ التغييرات');
                    }
                });
            });

            // =====================================================
            // حذف الامتحان
            // =====================================================
            $(document).on("click", ".delete-exam-btn", function() {
                var examId = $(this).data("id");
                var examTitle = $(this).data("title");
                $("#deleteExamTitle").text(examTitle);
                $("#confirmDeleteExam").data("id", examId);
                $("#deleteExamModal").modal("show");
                $('.dropdown-menu-custom.show').removeClass('show');
                $('.dropdown-menu-custom').css('position', '');
            });

            $("#confirmDeleteExam").click(function() {
                var examId = $(this).data("id");
                var $btn = $(this);
                
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> جاري الحذف...');

                $.ajax({
                    url: '@Url.Action("Delete", "Exam")/' + examId,
                    type: 'POST',
                    success: function() {
                        $('#deleteExamModal').modal('hide');
                        location.reload();
                    },
                    error: function(xhr) {
                        alert(xhr.responseText);
                        $btn.prop('disabled', false).html('حذف الامتحان');
                    }
                });
            });
            
            // معالجة مشكلة اللمس على الموبايل
            if (isMobile) {
                // منع التمرير الخلفي عند فتح القائمة
                $('.dropdown-menu-custom').on('touchmove', function(e) {
                    e.stopPropagation();
                });
                
                // تحسين تجربة اللمس للأزرار
                $('.dropdown-trigger').on('touchstart', function(e) {
                    // لا نحتاج لفعل إضافي، فقط نضمن أن الحدث يعمل
                });
            }
        });
    </script>
}