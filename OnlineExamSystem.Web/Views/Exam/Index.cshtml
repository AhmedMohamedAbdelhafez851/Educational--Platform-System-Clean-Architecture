@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<OnlineExamSystem.Application.DTOs.Exam.ExamListDto>

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
}

<style>
    /* RTL Table Styles */
    .table th,
    .table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    @@if (isRtl) {
        .table {
            text-align: right;
        }

            .table th,
            .table td {
                text-align: right;
            }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            text-align: right;
        }

            .dataTables_wrapper .dataTables_filter input {
                margin-left: 0;
                margin-right: 0.5em;
            }
    }

    /* Actions Buttons Container */
    .action-buttons {
        display: flex;
        gap: 0.25rem;
        flex-wrap: nowrap;
        min-width: max-content;
    }

        .action-buttons .btn {
            white-space: nowrap;
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }

    /* Badge Styles */
    .badge {
        font-size: 0.75rem;
        padding: 0.35rem 0.65rem;
    }

    /* Table Container Overflow */
    .table-responsive {
        overflow-x: auto;
    }

    /* DataTables Customization */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 1rem;
    }

    /* Make table more compact */
    .table td, .table th {
        padding: 0.75rem;
    }

    /* Responsive */
    @@media (max-width: 1400px) {
        .action-buttons .btn {
            font-size: 0.7rem;
            padding: 0.2rem 0.4rem;
        }

        .action-buttons {
            gap: 0.15rem;
        }

        .table td, .table th {
            padding: 0.5rem;
        }
    }

    @@media (max-width: 1200px) {
        .action-buttons .btn i {
            margin-right: 0;
        }

        .action-buttons .btn span {
            display: none;
        }

        .action-buttons .btn {
            padding: 0.35rem 0.5rem;
        }
    }
</style>

<div class="container-fluid mt-4">
    <div class="card shadow border-0">

        <!-- Header -->
        <div class="card-header d-flex justify-content-between align-items-center py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 1rem 1rem 0 0;">
            <h3 class="mb-0 fw-bold text-white">
                @Localizer["ExamManagement"]
            </h3>

            <button type="button"
                    class="btn btn-light btn-lg px-4 rounded-pill shadow-sm d-flex align-items-center gap-2"
                    data-bs-toggle="modal"
                    data-bs-target="#createExamModal"
                    style="background: white; color: #667eea; border: none;">
                <i class="bi bi-plus-circle fs-5"></i>
                <span class="fw-semibold">
                    @Localizer["CreateExam"]
                </span>
            </button>
        </div>

        <!-- Body -->
        <div class="card-body p-4">

            <div class="table-responsive">

                <table id="examsTable"
                       class="table table-striped table-hover align-middle"
                       style="width:100%">

                    <thead class="table-light">
                        <tr>
                            <th style="text-align: @(isRtl ? "right" : "left");">@Localizer["Title"]</th>
                            <th style="text-align: @(isRtl ? "right" : "left");">@Localizer["TimeMinutes"]</th>
                            <th style="text-align: @(isRtl ? "right" : "left");">@Localizer["Degree"]</th>
                            <th style="text-align: @(isRtl ? "right" : "left");">@Localizer["Questions"]</th>
                            <th style="text-align: @(isRtl ? "right" : "left"); min-width: 450px;">@Localizer["Actions"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var exam in Model)
                            {
                                <tr id="exam-row-@exam.ExamId">
                                    <!-- Title -->
                                    <td class="fw-semibold" style="text-align: @(isRtl ? "right" : "left");">@exam.Title</td>

                                    <!-- Time -->
                                    <td style="text-align: @(isRtl ? "right" : "left");">
                                        <span class="badge bg-secondary">@exam.DurationInMinutes دقيقة</span>
                                    </td>

                                    <!-- Degree -->
                                    <td style="text-align: @(isRtl ? "right" : "left");">
                                        <span class="badge bg-success">@exam.TotalDegree درجة</span>
                                    </td>

                                    <!-- Questions -->
                                    <td style="text-align: @(isRtl ? "right" : "left");">
                                        <span class="badge bg-info">@exam.QuestionsCount سؤال</span>
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: @(isRtl ? "right" : "left");">
                                        <div class="action-buttons">
                                            <a asp-controller="Question" asp-action="Index" asp-route-examId="@exam.ExamId" class="btn btn-sm btn-outline-primary" title="@Localizer["QuestionsButton"]">
                                                <i class="bi bi-list-check"></i> <span>@Localizer["QuestionsButton"]</span>
                                            </a>
                                            <a asp-action="Invitations" asp-route-examId="@exam.ExamId" class="btn btn-sm btn-outline-success" title="@Localizer["LinksButton"]">
                                                <i class="bi bi-link-45deg"></i> <span>@Localizer["LinksButton"]</span>
                                            </a>
                                            <a asp-controller="Analytics" asp-action="ExamReport" asp-route-examId="@exam.ExamId" class="btn btn-sm btn-outline-info" title="@Localizer["AnalyticsButton"]">
                                                <i class="bi bi-graph-up"></i> <span>@Localizer["AnalyticsButton"]</span>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-warning edit-exam-btn"
                                                    data-id="@exam.ExamId" data-title="@exam.Title"
                                                    data-time="@exam.DurationInMinutes" data-degree="@exam.TotalDegree"
                                                    title="@Localizer["EditButton"]">
                                                <i class="bi bi-pencil-fill"></i> <span>@Localizer["EditButton"]</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger delete-exam-btn"
                                                    data-id="@exam.ExamId" data-title="@exam.Title"
                                                    title="@Localizer["DeleteButton"]">
                                                <i class="bi bi-trash-fill"></i> <span>@Localizer["DeleteButton"]</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ===================================================== -->
<!-- CREATE MODAL -->
<!-- ===================================================== -->
<div class="modal fade" id="createExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; padding: 1.25rem 1.5rem;">
                <h5 class="modal-title text-white fw-semibold">
                    <i class="bi bi-plus-circle me-2"></i>
                    @Localizer["CreateNewExam"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="createExamForm">
                <div class="modal-body p-4" style="background: #ffffff;">
                    <div class="form-floating mb-4">
                        <input type="text" class="form-control" id="examTitle" name="Title" placeholder="@Localizer["ExamTitle"]" required style="border-radius: 0.75rem; border: 1.5px solid #e2e8f0;">
                        <label for="examTitle">@Localizer["ExamTitle"]</label>
                    </div>
                    <div class="form-floating mb-4">
                        <input type="number" class="form-control" id="examTime" name="DurationInMinutes" placeholder="@Localizer["TimePlaceholder"]" min="1" required style="border-radius: 0.75rem; border: 1.5px solid #e2e8f0;">
                        <label for="examTime">@Localizer["TimePlaceholder"]</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="number" class="form-control" id="examDegree" name="TotalDegree" placeholder="@Localizer["DegreePlaceholder"]" min="1" required style="border-radius: 0.75rem; border: 1.5px solid #e2e8f0;">
                        <label for="examDegree">@Localizer["DegreePlaceholder"]</label>
                    </div>
                </div>

                <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 1rem 1.5rem;">
                    <button type="button" class="btn px-4 py-2" data-bs-dismiss="modal" style="background: #f1f5f9; color: #64748b; border-radius: 0.75rem;">
                        <i class="bi bi-x-lg me-1"></i> @Localizer["Cancel"]
                    </button>
                    <button type="submit" class="btn px-4 py-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 0.75rem; border: none;">
                        <i class="bi bi-save me-1"></i> @Localizer["Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===================================================== -->
<!-- EDIT MODAL -->
<!-- ===================================================== -->
<div class="modal fade" id="editExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; padding: 1.25rem 1.5rem;">
                <h5 class="modal-title text-white fw-semibold">
                    <i class="bi bi-pencil-square me-2"></i>
                    @Localizer["UpdateExam"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="editExamForm">
                <div class="modal-body p-4" style="background: #ffffff;">
                    <input type="hidden" id="editExamId" name="Id">

                    <div class="form-floating mb-4">
                        <input type="text" class="form-control" id="editExamTitle" name="Title" placeholder="@Localizer["ExamTitle"]" required style="border-radius: 0.75rem; border: 1.5px solid #e2e8f0;">
                        <label for="editExamTitle">@Localizer["ExamTitle"]</label>
                    </div>
                    <div class="form-floating mb-4">
                        <input type="number" class="form-control" id="editExamTime" name="DurationInMinutes" min="1" required style="border-radius: 0.75rem; border: 1.5px solid #e2e8f0;">
                        <label for="editExamTime">@Localizer["TimePlaceholder"]</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="number" class="form-control" id="editExamDegree" name="TotalDegree" min="1" required style="border-radius: 0.75rem; border: 1.5px solid #e2e8f0;">
                        <label for="editExamDegree">@Localizer["DegreePlaceholder"]</label>
                    </div>
                </div>

                <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 1rem 1.5rem;">
                    <button type="button" class="btn px-4 py-2" data-bs-dismiss="modal" style="background: #f1f5f9; color: #64748b; border-radius: 0.75rem;">
                        <i class="bi bi-x-lg me-1"></i> @Localizer["Cancel"]
                    </button>
                    <button type="submit" class="btn px-4 py-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 0.75rem; border: none;">
                        <i class="bi bi-save me-1"></i> @Localizer["Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===================================================== -->
<!-- DELETE MODAL -->
<!-- ===================================================== -->
<div class="modal fade" id="deleteExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 1rem; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); border: none; padding: 1.25rem 1.5rem;">
                <h5 class="modal-title text-white fw-semibold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Localizer["ConfirmDelete"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center" style="background: #ffffff;">
                <div class="mb-3">
                    <i class="bi bi-trash-fill text-danger" style="font-size: 3rem;"></i>
                </div>
                <p class="mb-0 fs-5">
                    @Localizer["DeleteConfirmation"]
                    "<span id="deleteExamTitle" class="fw-bold"></span>" ?
                </p>
                <div class="alert alert-warning mt-3" style="border-radius: 0.75rem;">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    <small>@Localizer["DeleteWarning"]</small>
                </div>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0;">
                <button type="button" class="btn px-4 py-2" data-bs-dismiss="modal" style="background: #f1f5f9; color: #64748b; border-radius: 0.75rem;">
                    <i class="bi bi-x-lg me-1"></i> @Localizer["Cancel"]
                </button>
                <button type="button" class="btn px-4 py-2" id="confirmDeleteExam" style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); color: white; border-radius: 0.75rem; border: none;">
                    <i class="bi bi-trash-fill me-1"></i> @Localizer["Delete"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
        var isRtl = @(isRtl ? "true" : "false");

        // Initialize DataTable
        $('#examsTable').DataTable({
        responsive: true,
        pageLength: 10,
        scrollX: true,
        language: isRtl ? {
        sProcessing: "جارٍ التحميل...",
        sLengthMenu: "أظهر _MENU_ مدخلات",
        sZeroRecords: "لم يتم العثور على نتائج",
        sInfo: "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
        sInfoEmpty: "يعرض 0 إلى 0 من أصل 0 سجل",
        sInfoFiltered: "(تمت التصفية من مجموع _MAX_ مدخل)",
        sSearch: "ابحث:",
        oPaginate: {
        sFirst: "الأول",
        sPrevious: "السابق",
        sNext: "التالي",
        sLast: "الأخير"
        }
        } : {}
        });

        // =====================================================
        // CREATE EXAM
        // =====================================================
        $("#createExamForm").submit(function (e) {
        e.preventDefault();
        var $form = $(this);
        var $submitBtn = $form.find('button[type="submit"]');

        $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Creating...');

        $.ajax({
        url: '@Url.Action("Create", "Exam")',
        type: 'POST',
        data: $form.serialize(),
        success: function () {
        $('#createExamModal').modal('hide');
        location.reload();
        },
        error: function (xhr) {
        alert(xhr.responseText);
        $submitBtn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> @Localizer["Save"]');
        }
        });
        });

        // =====================================================
        // OPEN EDIT
        // =====================================================
        $(document).on("click", ".edit-exam-btn", function () {
        $("#editExamId").val($(this).data("id"));
        $("#editExamTitle").val($(this).data("title"));
        $("#editExamTime").val($(this).data("time"));
        $("#editExamDegree").val($(this).data("degree"));
        $("#editExamModal").modal("show");
        });

        // =====================================================
        // EDIT EXAM
        // =====================================================
        $("#editExamForm").submit(function (e) {
        e.preventDefault();
        var examId = $("#editExamId").val();
        var $form = $(this);
        var $submitBtn = $form.find('button[type="submit"]');

        $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Updating...');

        $.ajax({
        url: '@Url.Action("Edit", "Exam")/' + examId,
        type: 'POST',
        data: $form.serialize(),
        success: function () {
        $('#editExamModal').modal('hide');
        location.reload();
        },
        error: function (xhr) {
        alert(xhr.responseText);
        $submitBtn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> @Localizer["Save"]');
        }
        });
        });

        // =====================================================
        // OPEN DELETE
        // =====================================================
        $(document).on("click", ".delete-exam-btn", function () {
        var examId = $(this).data("id");
        var examTitle = $(this).data("title");
        $("#deleteExamTitle").text(examTitle);
        $("#confirmDeleteExam").data("id", examId);
        $("#deleteExamModal").modal("show");
        });

        // =====================================================
        // DELETE EXAM
        // =====================================================
        $("#confirmDeleteExam").click(function () {
        var examId = $(this).data("id");
        var $btn = $(this);

        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Deleting...');

        $.ajax({
        url: '@Url.Action("Delete", "Exam")/' + examId,
        type: 'POST',
        success: function () {
        $('#deleteExamModal').modal('hide');
        location.reload();
        },
        error: function (xhr) {
        alert(xhr.responseText);
        $btn.prop('disabled', false).html('<i class="bi bi-trash-fill me-1"></i> @Localizer["Delete"]');
        }
        });
        });
        });
    </script>
}