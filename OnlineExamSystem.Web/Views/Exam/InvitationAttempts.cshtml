@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model List<OnlineExamSystem.Application.DTOs.Exam.ExamInvitationAttemptDto>
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header d-flex justify-content-between align-items-center py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 1rem 1rem 0 0;">
            <h3 class="mb-0 fw-semibold text-white">
                <i class="bi bi-people"></i> @Localizer["PageTitle"]
            </h3>
            <a asp-action="Invitations" asp-route-examId="@ViewBag.ExamId" class="btn btn-light" style="background: white; color: #667eea; border-radius: 2rem;">
                <i class="bi bi-arrow-left me-2"></i> @Localizer["BackToInvitations"]
            </a>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="empty-state p-5 text-center">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #cbd5e1;"></i>
                    <h5 class="mt-3 text-muted">@Localizer["NoAttempts"]</h5>
                    <p class="text-muted">@Localizer["NoAttemptsMessage"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Localizer["StudentName"]</th>
                                <th>@Localizer["Email"]</th>
                                <th>@Localizer["StartedAt"]</th>
                                <th>@Localizer["CompletedAt"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Score"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attempt in Model)
                            {
                                <tr>
                                    <td><div class="fw-medium">@attempt.StudentName</div></td>
                                    <td>@(attempt.StudentEmail ?? "-")</td>
                                    <td>@attempt.StartedAt.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                    <td>@(attempt.CompletedAt?.ToString("MMM dd, yyyy - hh:mm tt") ?? "-")</td>
                                    <td>
                                        <span class="badge @(attempt.IsCompleted ? "bg-success" : "bg-warning")">
                                            @(attempt.IsCompleted ? Localizer["Completed"] : Localizer["InProgress"])
                                        </span>
                                    </td>
                                    <td>
                                        @if (attempt.Score.HasValue)
                                        {
                                            <strong class="@(attempt.Score >= 50 ? "text-success" : "text-danger")">@attempt.Score.Value.ToString("F1")%</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize tooltips if any
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}