@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@model List<OnlineExamSystem.Application.DTOs.Exam.ExamInvitationDto>
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var examId = ViewBag.ExamId;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var isRtl = CultureInfo.CurrentUICulture.Name == "ar-EG";
}

@section Styles {
    <link href="~/css/pages/invitations.css" rel="stylesheet" />
}

<div class="invitations-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-link-45deg"></i>
                @Localizer["PageTitle"]
            </h1>
            <p class="page-subtitle">@Localizer["PageSubtitle"]</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-primary-custom" onclick="openCreateInvitationModal()">
                <i class="bi bi-plus-circle"></i>
                @Localizer["GenerateNewLink"]
            </button>
            <a asp-action="Index" asp-route-examId="@examId" class="btn btn-outline-custom">
                <i class="bi bi-arrow-left"></i>
                @Localizer["BackToExams"]
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-link-45deg"></i>
            </div>
            <h4>@Localizer["NoInvitations"]</h4>
            <p>@Localizer["NoInvitationsMessage"]</p>
        </div>
    }
    else
    {
        <div class="invitations-grid">
            @foreach (var inv in Model)
            {
                var fullLink = $"{baseUrl}/UserExam/Join?code={inv.InvitationCode}";
                <div class="invitation-card" id="invitation-@inv.Id">
                    <div class="card-header">
                        <div class="invitation-code">
                            <i class="bi bi-key"></i>
                            <span>@inv.InvitationCode</span>
                        </div>
                        <div class="card-status @(inv.IsActive ? "status-active" : "status-inactive")">
                            @(inv.IsActive ? Localizer["Active"].Value : Localizer["Inactive"].Value)
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="link-container">
                            <input type="text" class="invitation-link" value="@fullLink" readonly id="link-@inv.Id">
                            <button class="btn-copy" onclick="copyToClipboard('@fullLink', @inv.Id)">
                                <i class="bi bi-clipboard"></i>
                                @Localizer["Copy"]
                            </button>
                        </div>
                        <div class="stats-grid">
                            <div class="stat-item">
                                <div class="stat-label">@Localizer["CreatedAt"]</div>
                                <div class="stat-value">@inv.CreatedAt.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-label">@Localizer["ExpiresAt"]</div>
                                <div class="stat-value">@(inv.ExpiresAt?.ToString("MMM dd, yyyy") ?? Localizer["Never"].Value)</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-label">@Localizer["AttemptsUsed"]</div>
                                <div class="stat-value">@inv.UsedCount / @inv.MaxAttempts</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn-action @(inv.IsActive ? "btn-disable" : "btn-enable")" onclick="toggleInvitation(@inv.Id, @(inv.IsActive.ToString().ToLower()))">
                            <i class="bi @(inv.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                            @(inv.IsActive ? Localizer["Disable"].Value : Localizer["Enable"].Value)
                        </button>
                        <a asp-action="InvitationAttempts" asp-route-id="@inv.Id" class="btn-action btn-attempts">
                            <i class="bi bi-people"></i>
                            @Localizer["ViewAttempts"]
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Invitation Modal -->
<div class="modal fade" id="createInvitationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header custom-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle"></i>
                    @Localizer["GenerateNewLink"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">@Localizer["ExpirationDate"]</label>
                    <input type="datetime-local" id="expiresAt" class="form-control custom-input">
                    <small class="form-text text-muted">@Localizer["ExpirationHelp"]</small>
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["MaxAttempts"]</label>
                    <input type="number" id="maxAttempts" class="form-control custom-input" value="1" min="1" max="10">
                    <small class="form-text text-muted">@Localizer["MaxAttemptsHelp"]</small>
                </div>
            </div>
            <div class="modal-footer custom-modal-footer">
                <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary-custom" id="generateInvitationBtn">
                    <i class="bi bi-plus-circle"></i> @Localizer["Generate"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@section Scripts {
    <script>
        function copyToClipboard(link, id) {
            navigator.clipboard.writeText(link).then(function () {
                showToast('success', '@Localizer["Copied"]', '@Localizer["LinkCopied"]');
                var btn = document.querySelector(`#link-${id}`).nextElementSibling;
                var originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check"></i> @Localizer["Copied!"]';
                setTimeout(function () { btn.innerHTML = originalHtml; }, 2000);
            });
        }

        function toggleInvitation(id, isActive) {
            $.ajax({
                url: '@Url.Action("ToggleInvitation", "Exam")',
                type: 'POST',
                data: { invitationId: id, isActive: !isActive },
                success: function () { location.reload(); },
                error: function (xhr) { showToast('error', '@Localizer["Error"]', xhr.responseText); }
            });
        }

        function openCreateInvitationModal() {
            $('#expiresAt').val('');
            $('#maxAttempts').val(1);
            $('#createInvitationModal').modal('show');
        }

        $('#generateInvitationBtn').click(function () {
            var expiresAt = $('#expiresAt').val();
            var maxAttempts = $('#maxAttempts').val();
            var $btn = $(this);
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Generating"]...');

            $.ajax({
                url: '@Url.Action("CreateInvitation", "Exam")',
                type: 'POST',
                data: { examId: @examId, expiresAt: expiresAt, maxAttempts: maxAttempts },
                success: function () { location.reload(); },
                error: function (xhr) { showToast('error', '@Localizer["Error"]', xhr.responseText); $btn.prop('disabled', false).html('<i class="bi bi-plus-circle"></i> @Localizer["Generate"]'); }
            });
        });

        function showToast(type, title, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var iconClass = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
            var toastHtml = `<div class="toast align-items-center border-0 ${bgClass} text-white show" role="alert">
                        <div class="d-flex"><div class="toast-body"><i class="bi ${iconClass} me-2"></i> <strong>${title}</strong> - ${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            $('.toast-container').append(toastHtml);
            setTimeout(function () { $('.toast-container .toast').first().remove(); }, 3000);
        }
    </script>
}