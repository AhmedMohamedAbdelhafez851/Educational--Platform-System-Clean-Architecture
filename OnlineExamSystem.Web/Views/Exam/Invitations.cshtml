@model List<OnlineExamSystem.Application.DTOs.Exam.ExamInvitationDto>
@{
    ViewData["Title"] = "Exam Invitations";
    var examId = ViewBag.ExamId;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3><i class="bi bi-link-45deg"></i> Exam Invitation Links</h3>
            <p class="mb-0">Share these links with students to take the exam</p>
        </div>
        <div class="card-body">
            <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#createInvitationModal">
                <i class="bi bi-plus-circle"></i> Generate New Link
            </button>

            <a asp-action="Index" asp-route-examId="@examId" class="btn btn-outline-secondary mb-3 ms-2">
                <i class="bi bi-arrow-left"></i> Back to Exams
            </a>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle fs-1"></i>
                    <h5>No invitation links yet</h5>
                    <p>Click "Generate New Link" to create an invitation for students.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Code</th>
                                <th>Invitation Link</th>
                                <th>Created</th>
                                <th>Expires</th>
                                <th>Used/Max</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model)
                            {
                                var fullLink = $"{baseUrl}/UserExam/Join?code={inv.InvitationCode}";
                                <tr>
                                    <td>
                                        <span class="badge bg-dark fs-6">@inv.InvitationCode</span>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control font-monospace" value="@fullLink" readonly id="link-@inv.Id" style="min-width: 300px;">
                                            <button class="btn btn-outline-secondary copy-link" data-link="@fullLink" data-id="@inv.Id">
                                                <i class="bi bi-clipboard"></i> Copy
                                            </button>
                                        </div>
                                    </td>
                                    <td>@inv.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@(inv.ExpiresAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</td>
                                    <td>@inv.UsedCount / @inv.MaxAttempts</td>
                                    <td>
                                        <span class="badge @(inv.IsActive ? "bg-success" : "bg-danger")">
                                            @(inv.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn @(inv.IsActive ? "btn-warning" : "btn-success") toggle-invitation"
                                                    data-id="@inv.Id" data-active="@inv.IsActive.ToString().ToLower()">
                                                <i class="bi @(inv.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                @(inv.IsActive ? "Disable" : "Enable")
                                            </button>
                                            <a asp-action="InvitationAttempts" asp-route-id="@inv.Id" class="btn btn-info">
                                                <i class="bi bi-people"></i> Attempts
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Invitation Modal -->
<div class="modal fade" id="createInvitationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-link-45deg"></i> Generate New Invitation Link</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Expiration Date (Optional)</label>
                    <input type="datetime-local" id="expiresAt" class="form-control">
                    <small class="text-muted">Leave empty for no expiration</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Max Attempts per Student</label>
                    <input type="number" id="maxAttempts" class="form-control" value="1" min="1" max="10">
                    <small class="text-muted">How many times a student can take this exam</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="generateInvitationBtn">
                    <i class="bi bi-plus-circle"></i> Generate Link
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Generate invitation
        $('#generateInvitationBtn').click(function () {
            var expiresAt = $('#expiresAt').val();
            var maxAttempts = $('#maxAttempts').val();

            $.ajax({
                url: '@Url.Action("CreateInvitation", "Exam")',
                type: 'POST',
                data: {
                    examId: @examId,
                    expiresAt: expiresAt,
                    maxAttempts: maxAttempts
                },
                success: function () {
                    location.reload();
                },
                error: function (xhr) {
                    alert('Error: ' + xhr.responseText);
                }
            });
        });

        // Copy link to clipboard
        $('.copy-link').click(function () {
            var link = $(this).data('link');
            navigator.clipboard.writeText(link).then(function () {
                // Show temporary success message
                var btn = $(this);
                var originalHtml = btn.html();
                btn.html('<i class="bi bi-check"></i> Copied!');
                setTimeout(function () {
                    btn.html(originalHtml);
                }, 2000);
            }.bind(this));
        });

        // Toggle invitation status
        $('.toggle-invitation').click(function () {
            var id = $(this).data('id');
            var isActive = $(this).data('active') === 'true';

            $.ajax({
                url: '@Url.Action("ToggleInvitation", "Exam")',
                type: 'POST',
                data: {
                    invitationId: id,
                    isActive: !isActive
                },
                success: function () {
                    location.reload();
                },
                error: function (xhr) {
                    alert('Error: ' + xhr.responseText);
                }
            });
        });
    </script>
}